-- text.þ: string formatting, parsing, and value rendering.
-- Strings in Thunky are lists of Unicode code points, so all list operations
-- work on them directly. This module adds higher-level formatting utilities.
import list, math, core, maybe in

module

-- char s: code point of the first (or only) character of string s
-- char s: the first code point of a string. Partial, and marked: it exists so
-- that `char '0'` reads well, and a literal discharges the assumption at the call
-- site. Anywhere the string is computed, use headOr instead.
--> char : List Num! -> Num
char = head,

-- Named code points for characters that cannot appear in string literals
nul       = 0,   -- \0  null
tab       = 9,   -- \t  horizontal tab
lf        = 10,  -- \n  line feed (newline on Unix)
cr        = 13,  -- \r  carriage return
esc       = 27,  -- \e  escape
space     = 32,  --     space
dquote    = 34,  -- \"  double quote
quote     = 39,  -- \'  single quote (string delimiter in Thunky)
backslash = 92,  -- \\  backslash

-- join separator strings: intercalate separator between each string in the list
join = separator -> {
	[] -> [],
	[h,t] -> t > {
		[] -> h,
		t2 -> prepend h (prepend separator (join separator t2))
	}
},

-- lines s: split on line feeds, treating a preceding carriage return as part
-- of the same break — so "\n" and "\r\n" both end a line, and a lone "\r" is
-- left alone rather than guessed at. A single trailing newline does not
-- produce a final empty line, so `lines` of a file that ends in a newline
-- gives exactly the lines it contains.
--
-- One-liner equivalent, with
--   dropTrailingEmpty = ls -> if (isEmpty ls) ls (if (isEmpty (last ls)) (init ls) ls):
--   lines = replaceAllSub [cr; lf] [lf;] *> split [lf;] *> dropTrailingEmpty
-- That is four passes and a full copy of the input — normalise every CRLF,
-- split again, then `last` and `init` to drop the trailing empty line — and
-- every program that reads stdin pays it. The direct recursion is one pass: the
-- empty input yields no lines at all, which is also what drops the final empty
-- line, since the text after a trailing newline is empty and recurses to [].
--
-- The span stops at either break character, so a line never holds the carriage
-- return in the first place and nothing has to look at its end to take one off;
-- what follows the line is what says how long the break is. A carriage return
-- with no line feed after it is not a break at all, and that is the one case
-- that costs anything: the line runs through it, so it has to be joined to
-- whatever the scan after it produces.
lines = {
	[] -> [],
	s -> s > span (c -> and (neq lf c) (neq cr c)) > {
		[line, []]        -> [line;],                     -- no break: the last line
		[line, [c, rest]] -> if (eq c lf)
			[line, lines rest]                            -- LF: a one-character break
			(rest > {                                     -- the break starts with CR
				[]         -> [append [cr;] line;],       -- at the very end: a lone CR
				[c2, more] -> if (eq c2 lf)
					[line, lines more]                    -- CRLF: a two-character break
					(lines rest > ([next, others] ->      -- lone CR: no break here
						[flatten [line; [cr;]; next], others]))
			})
	}
},

-- unlines ls: join a list of lines with line feeds, without a trailing one, so
-- that `unlines (lines s)` returns s for any s not ending in a newline.
unlines = join [lf;],

-- words s: split on runs of whitespace, discarding the empty pieces that
-- leading, trailing or repeated whitespace would otherwise leave.
words = splitWith isSpace *> filter (isEmpty *> not),

-- unwords ws: join a list of words with single spaces.
unwords = join " ",

-- padLeft n fill s: left-pad string s with code point fill to minimum width n
padLeft = n -> fill -> s -> let
	padLen = n > sub (length s) > max 0
in
	prepend (replicate padLen fill) s,

-- padRight n fill s: right-pad string s with code point fill to minimum width n
padRight = n -> fill -> s -> let
	padLen = n > sub (length s) > max 0
in
	append (replicate padLen fill) s,

-- trim s: remove leading and trailing whitespace from string s
trim = s -> dropWhile isSpace (reverse (dropWhile isSpace (reverse s))),

-- format template values: fill a template from a list of values, left to right.
-- `%s` takes a value that is already a string; `%v` takes any value and renders
-- it with `string`. `%%s` and `%%v` are those two characters literally, and any
-- other `%` is itself, so "5% of" needs no escaping. A placeholder with no value
-- left is copied through unchanged, and values past the last placeholder are
-- ignored. String literals may span lines, so a template can be a whole block.
format = template -> values -> template > {
	[] -> [],
	[c, rest] -> core.case
		(startsWith "%%s" template) (prepend "%s" (format (drop 3 template) values))
		(startsWith "%%v" template) (prepend "%v" (format (drop 3 template) values))
		(startsWith "%s" template) (values > {
			[]     -> prepend "%s" (format (drop 2 template) []),
			[v, t] -> prepend v (format (drop 2 template) t)
		})
		(startsWith "%v" template) (values > {
			[]     -> prepend "%v" (format (drop 2 template) []),
			[v, t] -> prepend (string v) (format (drop 2 template) t)
		})
		core.else (prepend [c;] (format rest values))
},

-- Character classification — all functions take a Unicode code point (integer)

isDigit    = c -> and (lte c (char '0')) (lte (char '9') c), -- 1 if c is a digit
isLower    = c -> and (lte c (char 'a')) (lte (char 'z') c), -- 1 if c is lowercase
isUpper    = c -> and (lte c (char 'A')) (lte (char 'Z') c), -- 1 if c is uppercase
isAlpha    = c -> or (isLower c) (isUpper c), -- 1 if c is a letter
isAlphaNum = c -> or (isAlpha c) (isDigit c), -- 1 if c is a letter or digit
isSpace    = c -> eq c space > or (eq c tab) > or (eq c lf) > or (eq c cr), -- 1 if c is whitespace

-- Character conversion
digitToInt = c -> sub (char '0') c, -- convert digit character to its numeric value
intToDigit = n -> add (char '0') n, -- convert numeric value to its digit character
toLower    = c -> if (isUpper c) (add (sub (char 'A') (char 'a')) c) c, -- convert to lowercase
toUpper    = c -> if (isLower c) (sub (sub (char 'A') (char 'a')) c) c, -- convert to uppercase

stringToLower = map toLower, -- convert a whole string to lowercase
stringToUpper = map toUpper, -- convert a whole string to uppercase

-- stringToInt s: parse a decimal integer string (optional leading '-') as a number.
-- No validation; non-digit characters produce wrong results.

parsePositive = foldl (acc -> c -> add (mul 10 acc) (digitToInt c)) 0,

stringToInt = {
	[] -> 0,
	[c, rest] -> if (eq c < char '-') (negate (parsePositive rest)) (parsePositive [c, rest])
},

-- startsWith prefix s: 1 if string s begins with prefix, else 0
startsWith = prefix -> s -> equal prefix (take (length prefix) s),

-- endsWith suffix s: 1 if string s ends with suffix, else 0
endsWith = suffix -> s -> let lenS = length s, lenP = length suffix in equal suffix (drop (sub lenP lenS) s),

-- stringToFloat s: parse a decimal float string (optional leading '-', optional '.').
-- No validation; non-digit/non-dot characters produce wrong results.
stringToFloat = s ->
	let
		zero         = char '0',
		neg          = char '-',
		dot          = char '.',
		parseFrac    = s -> parsePositive s > times (length s) (fdiv 10),
		parseUnsigned = span (c -> neq c dot) *> {
				[intPart, []]        -> parsePositive intPart,
				[intPart, [d, frac]] -> add (parsePositive intPart) (parseFrac frac)
			}
	in
		s > {
			[] -> 0,
			[c, rest] -> if (eq c neg)
				(negate < parseUnsigned rest)
				(parseUnsigned s)
		},

-- splitOne sep s: split string s on separator sep, but stop at the first occurrence
splitOne = sep -> s ->
	spans s >
	find ([left,right] -> startsWith sep right) >
	maybe.fmap ([left,right] -> [left; right > drop (length sep)]) >
	maybe.default [s;],

-- split sep s: split string s on all occurrences of sep. The empty separator
-- matches at every position without consuming anything, so it gets its own case:
-- it cuts s into single-character strings rather than looping forever on a
-- `splitOne` that hands back everything it was given.
split = {
	[] -> map singleton,
	sep -> splitOne sep *> {
		[s;] -> [s;],
		[left; right] -> prepend [left;] (split sep right)
	}
},

containsSub = sub -> l -> tails l > anyMatch (startsWith sub),
replaceSub = sub -> new -> splitOne sub *> join new,
replaceAllSub = sub -> new -> split sub *> join new,

-- splitOneWith f s: split on the first run of characters satisfying f.
-- Returns maybe.some [before, matched, after] or maybe.none.
splitOneWith = f -> s ->
	spans s >
	mapFilter ([left,right] -> span f right > {
		[[], rest] -> maybe.none,
		[matched, rest] -> maybe.some [left,matched,rest]
	}) >
	headSafe,

-- splitWith f s: split on all runs satisfying f; returns a list of non-matching sections.
splitWith = f -> s ->
	splitOneWith f s >
	maybe.fmap ([left, match, rest] -> prepend [left;] (splitWith f rest)) >
	maybe.default [s;],

-- replaceOneWith f repl s: replace the first run satisfying f with repl match.
replaceOneWith = f -> repl -> s ->
	splitOneWith f s >
	maybe.fmap ([left, match, right] -> flatten [left; repl match; right]) >
	maybe.default s,

-- replaceAllWith f repl s: replace every run satisfying f with repl match.
replaceAllWith = f -> repl -> s ->
	splitOneWith f s >
	maybe.fmap ([left, match, right] -> flatten [left; repl match; replaceAllWith f repl right]) >
	maybe.default s,

-- Lexicographic comparison
--
-- The builtin comparators only handle numbers, so ordering strings needs
-- these. They keep the threshold-first convention: `ltString a b` reads "does b
-- sort before a", so `sortStrings` is `sortWith ltString`, mirroring `list.sort`.
--
-- The String suffix is deliberate. Unqualified imports let a later module
-- shadow an earlier one, so calling these `lt`/`gt`/`sort` would hide the
-- numeric builtins and `list.sort` for every program that imports text.

-- ltString a b: 1 when b sorts strictly before a, comparing code point by code
-- point. A string sorts before any string that extends it, so "ab" < "abc".
ltString = a -> b -> [a, b] > {
	[[], _]           -> 0,          -- a exhausted: b equals a or extends it, so b is not before a
	[_, []]           -> 1,          -- b exhausted first: b is a proper prefix of a, so b is before a
	[[ha,ta],[hb,tb]] -> core.case
		(eq ha hb) (ltString ta tb)  -- same code point: compare the rest
		core.else (lte ha hb)        -- they differ, so hb <= ha means hb < ha
},

-- gtString a b: 1 when b sorts strictly after a.
gtString = a -> b -> ltString b a,

-- sortStrings l: the strings of l in ascending lexicographic order.
sortStrings = sortWith ltString,

-- Output ---------------------------------------------------------------------
--
-- A number and a string are distinguishable — a string is a cons cell, a number
-- is not — so these render each cell without being told which it is. What is
-- *not* distinguishable is a string from any other list of numbers: `[104; 105]`
-- is both "hi" and a two-element list. A list meant as data, not as text, has to
-- be rendered by the caller: `xs > map string > writeList`.

-- render v: v as text. A number becomes its digits; a string is already text and
-- passes through untouched. Any other list is treated as text, which is the one
-- case the caller has to disambiguate.
render = v -> v > {
	[]     -> [],       -- the empty string, not the value "[]"
	[h, t] -> v,        -- a cons cell: already a list of code points
	n      -> string n  -- a number: render it
},

-- writeList l: print one element of l per line, rendering numbers. Returns l, so
-- it drops into a pipeline. This is `map write > eval` without the `eval`: one
-- write instead of one per element, and no forcing hack to make the effects run.
writeList = {
	[] -> [],
	l  -> seq (l > map render > unlines > write) l
},

-- numericColumn cells: 1 when every cell is a number's rendering, so the column
-- should be right-aligned. Digits, at most one leading '-', and dots for floats.
numericColumn = allMatch (c -> let digits = c > dropWhile (eq (char '-')) in
	and (isEmpty digits > not) (digits > allMatch (d -> or (isDigit d) (eq (char '.') d)))),

-- tableLines rows: rows of cells as a list of aligned lines, columns separated by
-- two spaces. Every row is a *list* of cells — `[a; b]`, not `[a, b]`, which for
-- two strings would be the same value as a two-element list and split wrongly.
-- Short rows are padded with empty cells; columns of numbers are right-aligned;
-- no line carries trailing spaces.
tableLines = {
	[]   -> [],
	rows -> let
		grid    = rows > map (map render),
		columns = grid > map length > maximumOr 0,
		square  = grid > map (r -> append (replicate (sub (length r) columns) []) r),
		cells   = transpose square,
		specs   = zip (cells > map (map length *> maximumOr 0)) (cells > map numericColumn),
		pad     = [width, numeric] -> c -> if numeric (padLeft width space c) (padRight width space c)
	in
		square > map (r -> zipWith pad specs r
			> join "  "
			> reverse > dropWhile isSpace > reverse)
},

-- writeTable rows: print rows as an aligned table. Returns rows.
writeTable = {
	[]   -> [],
	rows -> seq (rows > tableLines > unlines > write) rows
}
