-- math.þ: numeric operations.
-- Imports core for `if`, and list for the stream plumbing behind `digits`.
import core, list in

module

-- builtin: add, mul, sub, div, fdiv, mod, fmod, sqrt, eq, lt, lte, gte, gt, neq

succ = add 1, -- successor: add 1
pred = sub 1, -- predecessor: subtract 1
negate = n -> sub n 0, -- arithmetic negation: negate n = 0 - n

-- signum n: sign of n (-1, 0, or 1)
signum = n -> if (eq n 0) 0 (if (lt 0 n) (negate 1) 1),

-- abs n: absolute value of n
abs = n -> if (lt 0 n) (negate n) n,

max = a -> b -> if (lt a b) a b, -- larger of two numbers
min = a -> b -> if (lt a b) b a, -- smaller of two numbers
clamp = lo -> hi -> n -> max lo (min hi n), -- clamp n to the range [lo, hi]

-- trunc n: round n towards zero (integer division by 1)
trunc = div 1,

-- isInteger n: checks if number is integer
isInteger = x -> eq x (trunc x),

-- floor n: round n towards negative infinity
floor = n ->
	let t = trunc n in
	if (lt 0 n)           -- n < 0
		(if (eq t n) t (sub 1 t))
		t,

-- ceil n: round n towards positive infinity
ceil = n ->
	let t = trunc n in
	if (lt 0 n)           -- n < 0
		t
		(if (eq t n) t (add 1 t)),

-- round n: round n to the nearest integer, half toward positive infinity (round half up)
round = n -> floor (add 0.5 n),

-- floorMod a n: n mod a, always in [0, a) for positive a (mod truncates
-- toward zero, so mod 100 (-50) = -50; this corrects it back into range)
floorMod = a -> n -> let r = mod a n in if (lt 0 r) (add a r) r,

even = n -> eq 0 (mod 2 n), -- 1 if n is even
odd  = n -> eq 1 (mod 2 n), -- 1 if n is odd

-- gcd a b: greatest common divisor of a and b
gcd = a -> b ->
	let
		absA = abs a,
		absB = abs b,
		rec = {
			[x, 0] -> x,
			[x, y] -> rec [y, mod y x]  -- mod y x = x mod y (builtin: mod a b = b mod a)
		}
	in
		rec [absA, absB],

-- lcm a b: least common multiple of a and b
lcm = a -> b ->
	if (or (eq a 0) (eq b 0))
		0
		(abs (mul (div (gcd a b) b) a)),

-- digits n: list of the decimal digits of a non-negative integer n
digits = {
	0 -> [0;],
	n -> (n > iterate (div 10) > takeWhile (gt 0) > map (mod 10) > reverse)
},

-- factorial n: n! for non-negative integer n
factorial = {
	0 -> 1,
	n -> mul n (factorial (pred n))
}
