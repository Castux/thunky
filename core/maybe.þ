--> Maybe a = [] | [a]
-- maybe.þ: optional values, represented as a 1-tuple [x] or the empty tuple [].
-- Depends on nothing, so any module may import it.

module

some = x -> [x],
none = [],

isSome = {
	[x] -> 1,
	_ -> 0
},

isNone = {
	[] -> 1,
	_ -> 0
},

isMaybe = {
	[] -> 1,
	[x] -> 1,
	_ -> 0
},

fmap = f -> {
	[] -> [],
	[x] -> [f x]
},

-- andThen f m: if m is some x, apply f to x and return the result; propagate none.
-- f may return a maybe (chaining) or any other value (extraction + mapping).
andThen = f -> {
	[] -> [],
	[x] -> f x
},

value = [x] -> x,

default = def -> {
	[] -> def,
	[x] -> x
},

-- orElse other m: return m if it is some, otherwise other.
orElse = other -> {
	[] -> other,
	[x] -> [x]
},

-- mapDefault def f m: apply f to the wrapped value, or return def if none.
mapDefault = def -> f -> {
	[] -> def,
	[x] -> f x
}
