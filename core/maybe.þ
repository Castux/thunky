-- maybe.þ: optional values, represented as a 1-tuple [x] or the empty tuple [].
-- Depends on nothing, so any module may import it.

module

--> Maybe a = [] | [a]

--> some : a -> Maybe a
some = x -> [x],
--> none : Maybe a
none = [],

--> isSome : Maybe a -> Num
isSome = {
	[x] -> 1,
	_ -> 0
},

--> isNone : Maybe a -> Num
isNone = {
	[] -> 1,
	_ -> 0
},

--> isMaybe : a -> Num
isMaybe = {
	[] -> 1,
	[x] -> 1,
	_ -> 0
},

--> fmap : (a -> b) -> Maybe a -> Maybe b
fmap = f -> {
	[] -> [],
	[x] -> [f x]
},

-- andThen f m: if m is some x, apply f to x and return the result; propagate none.
-- f returns a maybe, so andThen chains operations that may each fail.
--> andThen : (a -> Maybe b) -> Maybe a -> Maybe b
andThen = f -> {
	[] -> [],
	[x] -> f x
},

--> value : Maybe a! -> a
value = [x] -> x,

--> default : a -> Maybe a -> a
default = def -> {
	[] -> def,
	[x] -> x
},

-- when cond x: some x if cond holds, none otherwise. Matching the condition
-- directly is what `core.if` does anyway, and it keeps this module dependency-free.
--> when : Num -> a -> Maybe a
when = cond -> x -> cond > { 1 -> [x], 0 -> [] },

-- elseWhen cond x m: m if it is some, otherwise some x when cond holds. With
-- `when` to open a chain and `default` to close it, this is a multiway
-- conditional built out of ordinary functions:
--
--     when     (magIsZero b) [[], []]
--     > elseWhen (lt a b)      [[], a]
--     > default  (divide a b)
--
-- Each branch is a separate application, so every part of it has a type — which
-- the variadic `case … else …` it replaces could not have. Laziness is unchanged:
-- orElse matches on its second argument and never touches the first when that is
-- some, so no branch after the first true one is forced.
--> elseWhen : Num -> a -> Maybe a -> Maybe a
elseWhen = cond -> x -> orElse (when cond x),

-- orElse other m: return m if it is some, otherwise other. Both are maybes and
-- so is the result, which is what distinguishes it from `default`: orElse picks
-- the first of two maybes and stays inside Maybe, where default leaves it.
-- (Scala names this pair orElse/getOrElse. Java's Optional.orElse is the
-- unwrapping one, so a reader coming from there wants `default`.)
--> orElse : Maybe a -> Maybe a -> Maybe a
orElse = other -> {
	[] -> other,
	[x] -> [x]
},

-- mapDefault def f m: apply f to the wrapped value, or return def if none.
--> mapDefault : a -> (b -> a) -> Maybe b -> a
mapDefault = def -> f -> {
	[] -> def,
	[x] -> f x
}
