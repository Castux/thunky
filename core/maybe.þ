-- maybe.þ: optional values, represented as a 1-tuple [x] or the empty tuple [].
-- Depends on nothing: the representation is plain tuples and every name here is
-- defined below. Importing it is unconditional either way, since Thunky permits
-- circular imports.

module

some = x -> [x],
none = [],

isSome = {
	[x] -> 1,
	_ -> 0
},

isNone = {
	[] -> 1,
	_ -> 0
},

isMaybe = {
	[] -> 1,
	[x] -> 1,
	_ -> 0
},

fmap = f -> {
	[] -> [],
	[x] -> [f x]
},

-- andThen f m: if m is some x, apply f to x and return the result; propagate none.
-- f returns a maybe, so andThen chains operations that may each fail.
andThen = f -> {
	[] -> [],
	[x] -> f x
},

value = [x] -> x,

default = def -> {
	[] -> def,
	[x] -> x
},

-- when cond x: some x if cond holds, none otherwise. The condition is matched
-- here rather than passed to `core.if`, so this module depends on nothing.
when = cond -> x -> cond > { 1 -> [x], 0 -> [] },

-- elseWhen cond x m: m if it is some, otherwise some x when cond holds. With
-- `when` to open a chain and `default` to close it, this is a multiway
-- conditional built out of ordinary functions:
--
--     when     (magIsZero b) [[], []]
--     > elseWhen (lt a b)      [[], a]
--     > default  (divide a b)
--
-- Each branch is a separate application, so every part of the chain has a type.
-- Only the branches that must be are forced: orElse matches on its second
-- argument and never touches the first when that is some, so nothing after the
-- first true condition is evaluated.
elseWhen = cond -> x -> orElse (when cond x),

-- orElse other m: return m if it is some, otherwise other. Both are maybes and
-- so is the result, which is what distinguishes it from `default`: orElse picks
-- the first of two maybes and stays inside Maybe, where default leaves it.
orElse = other -> {
	[] -> other,
	[x] -> [x]
},

-- mapDefault def f m: apply f to the wrapped value, or return def if none.
mapDefault = def -> f -> {
	[] -> def,
	[x] -> f x
}
