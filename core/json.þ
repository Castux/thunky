-- json.þ: parsing and printing JSON.
--
-- ## The representation, and why it is tagged
--
-- JSON's types do not map onto Thunky's without ambiguity. A JSON string is a
-- list of code points and so is a JSON array of numbers; `true` and `null` have
-- no native counterpart at all. Values are therefore tagged 2-tuples:
--
--     ["null",   0]
--     ["bool",   0 or 1]
--     ["number", n]
--     ["string", code points]
--     ["array",  list of values]
--     ["object", list of [key, value] pairs, key a string, in document order]
--
-- The tags are strings rather than small integers so that a consumer can match
-- them literally, which is the whole ergonomic argument for this shape:
--
--     total = { ["number", n] -> n, ["array", items] -> sum (map total items), v -> 0 }
--
-- Objects keep their pairs in document order rather than sorting or hashing
-- them, because printing a parsed document should give it back unchanged. That
-- makes `get` O(n) in the number of keys; `toTable` hands the pairs to the
-- `table` module, and for a large object `hashmap.fromList` is one step away.
--
-- ## Parsing
--
-- Every parser has the shape `text -> maybe [value, rest]`: consume a prefix,
-- return the value and what is left, or `none`. They compose with
-- `maybe.andThen`, and the grammar below reads as the JSON spec does.
--
-- A `none` says only that the document is not valid, not where or why. Locating
-- an error would mean threading a position through every parser, which is a
-- real cost in a language with no mutable state — worth doing if this library
-- becomes load-bearing, and deliberately not done yet.

import core, list, math, maybe, text, table in

module

-- A JSON value is a tagged pair: the tag is a string, and what the content is
-- depends on which tag. The analysis joins the branches rather than keeping them
-- apart, so it cannot say "content is a number *when* the tag is \"number\"";
-- leaving the content a parameter says exactly as much as is true, and keeps the
-- signatures below readable.

-- --- constructors ---------------------------------------------------------

jsonNull   = ["null", 0],
jsonTrue   = ["bool", 1],
jsonFalse  = ["bool", 0],
jsonBool   = b -> ["bool", if b 1 0],
jsonNumber = n -> ["number", n],
jsonString = s -> ["string", s],
jsonArray  = items -> ["array", items],
jsonObject = pairs -> ["object", pairs],

-- --- inspection -----------------------------------------------------------

-- typeOf value: one of "null", "bool", "number", "string", "array", "object".
typeOf = [tag, content] -> tag,

isNull = [tag, content] -> equal tag "null",

-- get key value: the value for a key of an object, or none.
get = key -> [tag, content] -> if (equal tag "object")
	(content > find ([k, v] -> equal k key) > maybe.fmap second)
	maybe.none,

-- at index value: the element at a zero-based index of an array, or none.
at = index -> [tag, content] -> if (equal tag "array")
	(if (gte 0 index) (content > drop index > headSafe) maybe.none)
	maybe.none,

-- path keys value: follow a chain of object keys and array indices. A number in
-- the path indexes an array, a string looks up an object key.
-- The value is left a variable rather than claimed as a Value: path walks with
-- both `get` and `at`, and joining an object step with an array step loses the
-- tag pair, so `Value b` here would be a claim the code does not support.
path = steps -> value -> foldl (current -> step ->
	current > maybe.andThen (v -> if (isList step) (get step v) (at step v)))
	(maybe.some value) steps,

-- Extractors, each none if the value is not of that type.
asNumber = [tag, content] -> if (equal tag "number") (maybe.some content) maybe.none,
asString = [tag, content] -> if (equal tag "string") (maybe.some content) maybe.none,
asBool   = [tag, content] -> if (equal tag "bool")   (maybe.some content) maybe.none,
asArray  = [tag, content] -> if (equal tag "array")  (maybe.some content) maybe.none,
asObject = [tag, content] -> if (equal tag "object") (maybe.some content) maybe.none,

-- toTable value: an object's pairs as a `table`, for the get/set/update family.
toTable = [tag, content] -> if (equal tag "object") (table.fromList content) table.empty,

-- --- parsing --------------------------------------------------------------

-- parse text: some value if the whole of text is one JSON document, else none.
parse = parseValue *> maybe.andThen ([value, rest] ->
	if (isEmpty (skipSpace rest)) (maybe.some value) maybe.none),

-- skipSpace text: drop leading JSON whitespace.
skipSpace = dropWhile isSpace,

-- parseValue text: the value at the head of text, and what follows it.

parseValue = skipSpace *> {
	[] -> maybe.none,
	[c, rest] ->
		when       (eq c (char '{')) (parseObjectBody (skipSpace rest))
		> elseWhen (eq c (char '[')) (parseArrayBody (skipSpace rest))
		> elseWhen (eq c dquote)     (parseStringBody rest > maybe.fmap ([s, r] -> [["string", s], r]))
		> elseWhen (eq c (char 't')) (parseLiteral "true" jsonTrue [c, rest])
		> elseWhen (eq c (char 'f')) (parseLiteral "false" jsonFalse [c, rest])
		> elseWhen (eq c (char 'n')) (parseLiteral "null" jsonNull [c, rest])
		> default                    (parseNumber [c, rest])
},

parseLiteral = word -> value -> text -> if (startsWith word text)
	(maybe.some [value, drop (length word) text])
	maybe.none,

-- Numbers: the JSON grammar's int/frac/exp, scanned as one span and then
-- converted. `stringToFloat` handles the sign and the fraction; the exponent is
-- applied here.
isNumberChar = c -> or (isDigit c) (contains c "+-.eE"),

-- parseNumber text, toNumber digits: a JSON number and its conversion.
parseNumber = span isNumberChar *> ([digits, rest] ->
	if (isEmpty digits) maybe.none (maybe.some [["number", toNumber digits], rest])),

toNumber = map (c -> if (eq c (char 'E')) (char 'e') c)
	*> split "e"
	*> {
		[mantissa;]           -> stringToFloat mantissa,
		[mantissa; exponent]  -> mul (stringToFloat mantissa)
			(pow (stringToFloat (dropWhile (eq (char '+')) exponent)) 10),
		other                 -> 0
	},

-- parseStringBody text: the rest of a string, called with the opening quote
-- already consumed. parseEscape text: one escape sequence and the rest.
parseStringBody = {
	[] -> maybe.none,                                   -- unterminated
	[c, rest] ->
		when       (eq c dquote)    (maybe.some [[], rest])
		> elseWhen (eq c backslash) (parseEscape rest)
		> default                   (parseStringBody rest > maybe.fmap ([chars, r] -> [[c, chars], r]))
},

parseEscape = {
	[] -> maybe.none,
	[e, rest] -> if (eq e (char 'u'))
		(parseHex4 rest)
		(escapeChar e > maybe.andThen (ch ->
			parseStringBody rest > maybe.fmap ([chars, r] -> [[ch, chars], r])))
},

-- No `some` or `none` here: `when` already builds the maybe, and a chain that
-- matches nothing is none by construction.
escapeChar = e ->
	when       (eq e dquote)     dquote
	> elseWhen (eq e backslash)  backslash
	> elseWhen (eq e (char '/')) (char '/')
	> elseWhen (eq e (char 'n')) lf
	> elseWhen (eq e (char 't')) tab
	> elseWhen (eq e (char 'r')) cr
	> elseWhen (eq e (char 'b')) 8
	> elseWhen (eq e (char 'f')) 12,

hexValue = c ->
	when       (isDigit c)                                (digitToInt c)
	> elseWhen (and (lte c (char 'a')) (lte (char 'f') c)) (add 10 (sub (char 'a') c))
	> elseWhen (and (lte c (char 'A')) (lte (char 'F') c)) (add 10 (sub (char 'A') c)),

parseHex4 = text -> if (lt 4 (length text)) maybe.none
	-- allOrNone states the all-or-nothing requirement once, where testing with
	-- anyMatch isNone and then unwrapping with maybe.value would state it twice
	-- and leave only the test checkable.
	(take 4 text
		> map hexValue
		> allOrNone
		> maybe.fmap (foldl (acc -> d -> add d (mul 16 acc)) 0)
		> maybe.andThen (code -> parseStringBody (drop 4 text)
			> maybe.fmap ([chars, r] -> [[code, chars], r]))),

-- parseArrayBody text, parseObjectBody text: called with the opening bracket
-- consumed and whitespace skipped, so an immediate closing bracket is the empty
-- case. parseElements text and parseMembers text carry the comma-separated
-- runs, and parseMember text is one "key": value pair.
parseArrayBody = {
	[c, rest] -> if (eq c (char ']'))
		(maybe.some [["array", []], rest])
		(parseElements [c, rest] > maybe.fmap ([items, r] -> [["array", items], r])),
	[] -> maybe.none
},

parseElements = text -> parseValue text > maybe.andThen ([value, rest] ->
	skipSpace rest > (t -> t > {
		[c, more] ->
			when       (eq c (char ',')) (parseElements more > maybe.fmap ([items, r] -> [[value, items], r]))
			> elseWhen (eq c (char ']')) (maybe.some [[value;], more])
			> default                   maybe.none,
		[] -> maybe.none
	})),

parseObjectBody = {
	[c, rest] -> if (eq c (char '}'))
		(maybe.some [["object", []], rest])
		(parseMembers [c, rest] > maybe.fmap ([pairs, r] -> [["object", pairs], r])),
	[] -> maybe.none
},

parseMembers = text -> parseMember (skipSpace text) > maybe.andThen ([pair, rest] ->
	skipSpace rest > (t -> t > {
		[c, more] ->
			when       (eq c (char ',')) (parseMembers more > maybe.fmap ([pairs, r] -> [[pair, pairs], r]))
			> elseWhen (eq c (char '}')) (maybe.some [[pair;], more])
			> default                   maybe.none,
		[] -> maybe.none
	})),

parseMember = {
	[c, rest] -> if (eq c dquote)
		(parseStringBody rest > maybe.andThen ([key, afterKey] ->
			skipSpace afterKey > (t -> t > {
				[colon, afterColon] -> if (eq colon (char ':'))
					(parseValue afterColon > maybe.fmap ([value, r] -> [[key, value], r]))
					maybe.none,
				[] -> maybe.none
			})))
		maybe.none,
	[] -> maybe.none
},

-- --- printing -------------------------------------------------------------

-- stringify value: compact, no spaces.
stringify = [tag, content] ->
	when       (equal tag "null")   "null"
	> elseWhen (equal tag "bool")   (if content "true" "false")
	> elseWhen (equal tag "number") (string content)
	> elseWhen (equal tag "string") (quote content)
	> elseWhen (equal tag "array")  (flatten ["["; content > map stringify > join ","; "]"])
	> default                       (flatten ["{";
		content > map ([k, v] -> flatten [quote k; ":"; stringify v]) > join ",";
		"}"]),

-- quote s: s as a quoted JSON string. escapeOne c: one character, escaped.
quote = s -> flatten [[dquote;]; flatMap escapeOne s; [dquote;]],

escapeOne = c ->
	when       (eq c dquote)    (flatten [[backslash;]; [dquote;]])
	> elseWhen (eq c backslash) (flatten [[backslash;]; [backslash;]])
	> elseWhen (eq c lf)        (flatten [[backslash;]; "n"])
	> elseWhen (eq c cr)        (flatten [[backslash;]; "r"])
	> elseWhen (eq c tab)       (flatten [[backslash;]; "t"])
	> elseWhen (lt 32 c)        (flatten [[backslash;]; "u"; padLeft 4 (char '0') (toHex4 c)])
	> default                   [c;],

hexDigits = "0123456789abcdef",
toHex4 = n -> if (eq n 0) "0" (toHexGo n),
-- `mod 16` is always in [0, 15], so nthOr's default is unreachable.
toHexGo = n -> if (eq n 0) [] (append [nthOr 0 (mod 16 n) hexDigits;] (toHexGo (div 16 n))),

-- stringifyPretty indent value: one member or element per line, indented by
-- `indent` spaces per level. prettyAt indent depth value does the work.
stringifyPretty = indent -> prettyAt indent 0,

prettyAt = indent -> depth -> [tag, content] ->
	let
		pad   = n -> replicate (mul indent n) space,
		inner = succ depth
	in
		when (equal tag "array") (if (isEmpty content) "[]" (flatten [
			"["; [lf;];
			content
				> map (v -> flatten [pad inner; prettyAt indent inner v])
				> join (flatten [","; [lf;]]);
			[lf;]; pad depth; "]"]))
		> elseWhen (equal tag "object") (if (isEmpty content) "{}" (flatten [
			"{"; [lf;];
			content
				> map ([k, v] -> flatten [pad inner; quote k; ": "; prettyAt indent inner v])
				> join (flatten [","; [lf;]]);
			[lf;]; pad depth; "}"]))
		> default (stringify [tag, content])
