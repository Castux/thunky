--> List a = [] | [a, List a]
--> Stream a = [a, Stream a]
-- list.þ: list operations and infinite lists.
import math, core, maybe in

module

-- Construction and inspection

cons      = h -> t -> [h,t], -- construct a new list cell: h:t
emptyList = [],               -- the empty list
singleton = x -> [x;],       -- a one-element list

-- isList x: 1 if x is a proper list, else 0
isList = {
	[] -> 1,
	[x,xs] -> isList xs,
	n -> 0
},

isEmpty = { [] -> 1, l -> 0 }, -- 1 if list is empty, else 0

-- length l: number of elements in list l.
-- Left as a direct recursion rather than `foldlStrict (n -> _ -> succ n) 0`:
-- the strict fold keeps one number live instead of n nested `succ` thunks, but
-- it applies two closures per element where this applies none, and measures 30%
-- slower over 200k elements. Nearly everything else here measures a list before
-- working on it, so the constant wins.
length = {
	[] -> 0,
	[h,t] -> succ (length t)
},

head = [h,t] -> h, -- first element of a non-empty list
tail = [h,t] -> t, -- everything but the first element of a non-empty list
headSafe = {
	[] -> maybe.none,
	[h,t] -> maybe.some h
},
tailSafe = {
	[] -> maybe.none,
	[h,t] -> maybe.some t
},

-- last l: last element of a non-empty list
last = {
	[x, []] -> x,
	[h, t] -> last t
},

lastSafe = {
	[] -> maybe.none,
	l -> maybe.some (last l)
},

-- init l: everything but the last element of a non-empty list
init = {
	[x, []] -> [],
	[h, t] -> [h, init t]
},

initSafe = {
	[] -> maybe.none,
	l -> maybe.some (init l)
},

-- tails l: all successive suffixes of a list
tails = {
	[] -> [[];],
	[h,t] -> [[h,t], tails t]
},

-- inits l: all successive prefixes of a list
--
-- One-liner equivalent:
--   inits = { [] -> [[];], [h,t] -> prepend [[];] (inits t > map (cons h)) }
-- It builds prefix j out of prefix j-1 of the tail, so that prefix sits under j
-- layers of `map` and merely walking the spine costs O(n^2) — even when not one
-- prefix is ever forced, which is precisely what searching through `spans` does.
-- Indexing into l instead keeps the spine O(n) and charges each prefix its own
-- length, and only if it is forced. Forcing them all is O(n^2) either way: that
-- is the size of the answer.
inits = l -> prepend [[];] (mapIndex (i -> _ -> take (succ i) l) l),

-- Modification

-- prepend prefix xs: prefix followed by xs (first arg is fixed for partial application)
prepend = {
	[] -> xs -> xs,
	[h,t] -> xs -> [h, prepend t xs]
},

-- append suffix xs: xs followed by suffix; natural in a pipe: xs > append suffix
append = flip prepend,

-- reverse the order of elements in a list. Lazy on purpose: the accumulator is
-- a cons cell that costs nothing to build, so forcing it at each step (with
-- foldlStrict) only adds a `seq` per element — measured 15% slower over 200k.
reverse = foldl (flip cons) [],

-- intersperse sep l: place sep between every element in list l
intersperse = sep -> {
	[] -> [],
	[x, []] -> [x;],
	[h, t] -> [h, [sep, intersperse sep t]]
},

-- intercalate sep lists: flatten lists with sep inserted between each one
intercalate = sep -> intersperse sep *> flatten,

-- remove e l: remove the first occurrence of e from list l
remove = e -> {
	[] -> [],
	[h,t] -> if (equal e h) t [h, remove e t]
},

-- removeAll val l: remove every occurrence of val from list l
removeAll = val -> filter (equal val *> not),

-- replace old new l: replace the first occurrence of old with new in list l
replace = old -> new -> {
	[] -> [],
	[h,t] -> if (equal h old)
		[new, t]
		[h, replace old new t]
},

-- replaceAll old new l: replace every occurrence of old with new in list l
replaceAll = old -> new ->
	map (x -> if (equal x old) new x),

-- replaceAt idx val list: overwrite the element at index idx (zero-based)
replaceAt = idx -> val -> list ->
	prepend (take idx list) [val, drop (succ idx) list],

-- insertAt idx val list: insert val before index idx, shifting the rest right
insertAt = idx -> val -> list ->
	prepend (take idx list) [val, drop idx list],

-- removeAt idx list: remove the element at index idx (zero-based)
removeAt = idx -> list ->
	prepend (take idx list) (drop (succ idx) list),

-- Higher-order

-- map f l: apply f to every element in list l
map = f -> {
	[] -> [],
	[h,t] -> [f h, map f t]
},

-- mapIndex f l: replace every element with `f index element` with zero-based indices
mapIndex = f -> l ->
	zipWith f (upFrom 0) l,

-- filter f l: keep elements in l for which f returns 1
filter = f -> {
	[] -> [],
	[h,t] -> if (f h) [h, filter f t] (filter f t)
},

-- filterIndex f l: keep elements for which `f index element` returns 1 with zero-based indices
filterIndex = f ->
	zip (upFrom 0) *> filter (uncurry f) *> map second,

-- mapFilter f l: apply f (returning maybe) to each element; keep the some values unwrapped.
-- Single-pass; more efficient than map *> filter *> map.
mapFilter = f -> {
	[] -> [],
	[h, t] -> f h > {
		[] -> mapFilter f t,
		[x] -> [x, mapFilter f t]
	}
},

-- flatMap f l: map f over l then flatten the results
flatMap = f -> map f *> flatten,

-- find p l: first element of l matching predicate p (returns maybe)
find = p -> filter p *> headSafe,

-- findIndex p l: index of first element of l matching predicate p (returns maybe)
findIndex = p -> l -> let
	rec = i -> {
		[] -> maybe.none,
		[h,t] -> if (p h) (maybe.some i) (rec (add 1 i) t)
	}
in
	 rec 0 l,

-- foldr f acc l: right-associative reduction: f l1 (f l2 (... (f ln acc)))
foldr = f -> acc -> {
	[] -> acc,
	[h,t] -> f h (foldr f acc t)
},

-- foldl f acc l: left-associative reduction: f (... (f (f acc l1) l2) ...) ln
foldl = f -> acc -> {
	[] -> acc,
	[h,t] -> foldl f (f acc h) t
},

-- foldlStrict f acc l: like foldl, but forces the accumulator to WHNF at each step
-- (via seq) instead of building it lazily. foldl and foldr both build an accumulator
-- chain only forced at the end — O(n) deep — so a large list with a strict combiner
-- (e.g. building a hashmap of counts) forces a deep chain on the explicit stack and
-- holds every frame live at once. foldlStrict keeps the accumulator in WHNF as it
-- goes, so depth and live frames stay O(1). The `seq acc` wraps the case lambda so
-- the incoming accumulator is forced before the next step, while the recursive call
-- stays in tail position (had it been seq's second argument it would be a thunk, and
-- forcing each such thunk would stack an update frame per element — no better than
-- foldl). Use it whenever the combiner is strict in the accumulator and the list is
-- long.
foldlStrict = f -> acc -> seq acc {
	[] -> acc,
	[h,t] -> foldlStrict f (f acc h) t
},

-- scanl f acc l: list of successive left-fold results, starting with acc.
-- scanl f z [a;b;c] = [z; f z a; f (f z a) b; f (f (f z a) b) c]
scanl = f -> acc -> {
	[] -> [acc;],
	[h, t] -> [acc, scanl f (f acc h) t]
},

-- scanr f acc l: list of successive right-fold results, ending with acc.
-- scanr f z [a;b;c] = [f a r0; f b r1; f c z; z] where each r is the next scan value
scanr = f -> acc -> {
	[] -> [acc;],
	[h, t] -> let rest = scanr f acc t in [f h (head rest), rest]
},

-- Aggregations

-- These reduce a whole list to one number, so the accumulator is always forced
-- in the end: folding strictly costs one `seq` per element and saves building
-- the n-deep chain that `foldr add 0` or a lazy `foldl` would force all at once.
-- Over 200k elements that is 1.4x on sum, 1.5x on count and 1.6x on maximum,
-- besides bounding the depth. It is not free — `length` and `reverse` are left
-- lazy because for them the `seq` costs more than the chain does.
-- One-liner equivalents: foldr add 0, foldr mul 1, foldl (…) 0.
sum      = foldlStrict add 0, -- sum of a list of numbers
product  = foldlStrict mul 1, -- product of a list of numbers

-- These two stay lazy and right-associative on purpose: `or` and `and` short-
-- circuit, so anyMatch/allMatch stop at the first decisive element and work on
-- infinite lists. A strict fold would always walk the whole list.
orList   = foldr or 0,  -- logical OR over a list of booleans
andList  = foldr and 1, -- logical AND over a list of booleans

anyMatch  = f -> l -> orList (map f l),       -- 1 if f returns 1 for any element
allMatch  = f -> l -> andList (map f l),       -- 1 if f returns 1 for all elements
noneMatch = f -> l -> not (anyMatch f l),      -- 1 if f returns 0 for all elements
count     = p -> foldlStrict (acc -> x -> if (p x) (succ acc) acc) 0, -- count elements satisfying p

-- Zipping

-- zipWith f a b: combine two lists using function f element-wise
zipWith = f -> {
	[]		-> b -> [],
	[a,as]	-> {
		[]		-> [],
		[b,bs]	-> [f a b, zipWith f as bs]
	}
},

zip = zipWith cons, -- zip two lists into a list of 2-tuples

-- zipWith3 f a b c: combine three lists using function f element-wise
zipWith3 = f -> {
	[] -> b -> c -> [],
	[a, as] -> {
		[] -> c -> [],
		[b, bs] -> {
			[] -> [],
			[c, cs] -> [f a b c, zipWith3 f as bs cs]
		}
	}
},

zip3 = zipWith3 (a -> b -> c -> [a, b, c]), -- zip three lists into a list of 3-tuples

-- Slicing

-- take n l: first n elements of list l
take = {
	0 -> l -> [],
	n -> {
		[] -> [],
		[h,t] -> [h, take (pred n) t]
	}
},

-- drop n l: list l without its first n elements
drop = {
	0 -> l -> l,
	n -> {
		[] -> [],
		[h,t] -> drop (pred n) t
	}
},

-- slice a b l: the sub list between indices a and b (exclusive)
slice = start -> end ->
	drop start *> take (sub start end),

-- takeWhile f l: the prefix of list l for which f returns 1
takeWhile = f -> {
	[] -> [],
	[x,xs] -> if (f x)
		[x, takeWhile f xs]
		[]
},

-- dropWhile f l: list l without the prefix for which f returns 1
dropWhile = f -> {
	[] -> [],
	[x,xs] -> if (f x)
		(dropWhile f xs)
		[x,xs]
},

-- span f l: splits l into [taken while f holds, rest of list]
span = f -> {
	[] -> [[], []],
	[x, xs] -> if (f x)
		(span f xs > { [ts, fs] -> [[x, ts], fs] })
		[[], [x, xs]]
},

-- splitAt n l: split l into [first n elements, rest]
splitAt = n -> l -> [take n l, drop n l],

-- splitEqual n l: split l into sublists of length n
splitEqual = n ->
	iterate (drop n) *> map (take n) *> takeWhile (not <* isEmpty),

-- all successive splits of the list in two parts
spans = l -> zip (inits l) (tails l),

-- groupBy f l: split l into runs of consecutive elements where f h x = 1 (h is the first in each group)
groupBy = f -> {
	[] -> [],
	[h, t] -> span (f h) t > {
		[same, rest] -> [[h, same], groupBy f rest]
	}
},

-- flatten l: concatenate a list of lists into one list
flatten = foldr prepend [],

-- range a b: [a; a+1; ...; b-1], half open interval
range = a -> b -> upFrom a > take (sub a b),

-- rangeIncl a b: [a; a+1; ...; b], both endpoints inclusive
rangeIncl = a -> b -> range a (succ b),

-- Search and set-like

contains = elem -> anyMatch (equal elem), -- 1 if list contains elem, else 0

-- maximum l: largest element in list l (crashes on empty list)
maximum = [h,t] -> foldlStrict max h t,
-- minimum l: smallest element in list l (crashes on empty list)
minimum = [h,t] -> foldlStrict min h t,

-- nth n l: zero-based index into list l
nth = n -> drop n *> head,

-- nub l: remove duplicates, keeping only the first occurrence of each value
nub = {
	[] -> [],
	[h, t] -> [h, nub (filter (x -> not (equal x h)) t)]
},

-- lookup key l: search association list [[key, val]; ...]; returns maybe.some val or maybe.none
lookup = key -> {
	[] -> maybe.none,
	[[k, v], rest] -> if (equal k key) (maybe.some v) (lookup key rest)
},

-- Replication and structure

-- replicate n x: list of n copies of x
replicate = n -> repeat *> take n,

-- unzip l: converts [[a1,b1]; ...] into [[a1; ...], [b1; ...]]
unzip = {
	[] -> [[], []],
	[[a,b], rest] ->
		unzip rest > { [as, bs] -> [[a, as], [b, bs]] }
},

-- transpose rows: turn a list of rows into a list of columns; stops at the shortest row
transpose = {
	[] -> [],
	rows -> if (isEmpty (head rows)) [] [map head rows, transpose (map tail rows)]
},

-- Sorting

-- partition p l: splits l into [matching, rest]
partition = p ->
	foldr
	( x -> [ts,fs] -> if (p x) [[x,ts],fs] [ts,[x,fs]] )
	[[],[]],

-- sortWith f l: quicksort; f pivot elem = 1 if elem belongs before pivot
sortWith = f -> {
	[] -> [],
	[x,xs] -> partition (f x) xs > {
		[low,high] -> prepend (sortWith f low) [x, sortWith f high]
	}
},

sort = sortWith lt, -- sort in ascending order using lt

-- Infinite lists

iterate  = f -> x -> [x, iterate f (f x)], -- lazy infinite list: [x; f x; f (f x); ...]
times    = n -> f -> iterate f *> nth n,    -- apply function f n times
downFrom = iterate pred, -- lazy infinite list: [n; n-1; n-2; ...]
upFrom   = iterate succ, -- lazy infinite list: [n; n+1; n+2; ...]
repeat   = iterate id,   -- lazy infinite list of x
cycle    = l -> prepend l (cycle l) -- lazy infinite cycle of list l
