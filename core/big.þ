-- big.þ: arbitrary-precision integers and floats.
--
-- A Thunky number is a float64: exact for integers up to 2^53, and carrying 53
-- bits of significand. This module lifts both limits.
--
-- ## Representation
--
-- A **magnitude** is a little-endian list of *limbs*, each in [0, 2^32),
-- normalised so that the most significant limb is non-zero. The empty list is
-- zero. Base 2^32 is the largest that keeps a limb, and the sum of two limbs,
-- exactly representable in a float64.
--
-- Multiplication is the one place the base bites: the product of two limbs
-- reaches 2^64, well past the 2^53 a float64 holds exactly. `mulLimb` therefore
-- splits each limb into 16-bit halves, whose products are at most 2^32, and
-- reassembles the 64-bit result as a pair of limbs. Division by a small divisor
-- has the same problem in reverse — a remainder times the base overflows — so it
-- too works in 16-bit steps.
--
-- An **integer** is `[sign, magnitude]` with sign 1 or -1; zero is `[1, []]`,
-- and no operation produces a negative zero.
--
-- A **float** is `[mantissa, exponent, precision]`, meaning
-- `mantissa * 2^exponent`, where mantissa is an integer and precision is the
-- number of significand bits kept: every operation rounds its result back to
-- that many bits (truncating toward zero). Precision travels with the value,
-- so a computation inherits it rather than consulting a global setting.
--
-- ## Naming
--
-- An unqualified import puts every one of these names in the importer's scope,
-- where `add`, `mul` and `compare` already mean the builtins. So the integer
-- operations are `intAdd`, `intMul`, … and the float ones `floatAdd`,
-- `floatMul`, …, and both read well qualified: `big.intAdd`, `big.floatDiv`.

import core, math, list, maybe, text, bit in

module

--> BigInt = [Num, List Num]

--> base : Num
base      = 4294967296,     -- 2^32
--> halfBase : Num
halfBase  = 65536,          -- 2^16
--> limbBits : Num
limbBits  = 32,

-- --- magnitudes -----------------------------------------------------------

-- normalize limbs: drop the most significant zero limbs, so that every
-- magnitude has one representation and `equal` can be used on whole integers.
--> normalize : List Num -> List Num
normalize = reverse *> dropWhile (eq 0) *> reverse,

--> magZero : List Num
magZero = [],

-- magIsZero mag: is the magnitude zero (that is, empty).
--> magIsZero : List Num -> Num
magIsZero = isEmpty,

-- magFromNumber n: a magnitude from a non-negative integer-valued number.
-- Exact for n below 2^53, which is where a plain number stops being exact.
--> magFromNumber : Num -> List Num
magFromNumber = n -> if (lt 1 n) [] (prepend [mod base n;] (magFromNumber (div base n))),

--> magCompare : List Num -> List Num -> Num
magCompare = a -> b ->
	let la = length a, lb = length b in
		if (neq la lb)
			(if (lt lb la) (negate 1) 1)
			(magCompareSameLength (reverse a) (reverse b)),

-- Both lists most significant first and of equal length.
--> magCompareSameLength : List Num -> List Num -> Num
magCompareSameLength = xs -> ys -> xs > {
	[] -> 0,
	[x, xrest] -> ys > { [y, yrest] ->
		when       (lt y x) (negate 1)
		> elseWhen (lt x y) 1
		> default  (magCompareSameLength xrest yrest)
	}
},

--> magAdd : List Num -> List Num -> List Num
magAdd = a -> b ->
	let rec = carry -> x -> y -> if (and (isEmpty x) (isEmpty y))
		(if (eq carry 0) [] [carry;])
		(let
			hx = headOr 0 x,
			hy = headOr 0 y,
			s  = add carry (add hx hy)
		in
			[mod base s, rec (div base s) (drop 1 x) (drop 1 y)])
	in
		rec 0 a b,

-- magSub a b: a - b, requiring a >= b.
--> magSub : List Num -> List Num -> List Num
magSub = a -> b ->
	let rec = borrow -> x -> y -> if (isEmpty x)
		[]
		(let
			hx = headOr 0 x,
			hy = headOr 0 y,
			d  = sub (add borrow hy) hx        -- hx - (hy + borrow)
		in
			if (lt 0 d)
				[add base d, rec 1 (drop 1 x) (drop 1 y)]
				[d, rec 0 (drop 1 x) (drop 1 y)])
	in
		normalize (rec 0 a b),

-- mulLimb a b: the product of two limbs as [low, high], via 16-bit halves so
-- that no intermediate exceeds 2^53.
--> mulLimb : Num -> Num -> [Num, Num]
mulLimb = a -> b ->
	let
		al = mod halfBase a, ah = div halfBase a,
		bl = mod halfBase b, bh = div halfBase b,
		low0    = mul al bl,                       -- < 2^32
		middle  = add (mul al bh) (mul ah bl),     -- < 2^33
		high0   = mul ah bh,                       -- < 2^32
		low1    = add low0 (mul halfBase (mod halfBase middle)),   -- < 2^33
		low     = mod base low1,
		high    = add high0 (add (div halfBase middle) (div base low1))
	in
		[low, high],

--> magMulSmall : Num -> List Num -> List Num
magMulSmall = k -> mag ->
	let rec = carry -> m -> if (isEmpty m)
		(if (eq carry 0) [] [carry;])
		(let
			product = mulLimb k (headOr 0 m),
			low     = add (first product) carry,
			limb    = mod base low,
			carry2  = add (second product) (div base low)
		in
			[limb, rec carry2 (drop 1 m)])
	in
		normalize (rec 0 mag),

-- Shift by whole limbs: little-endian, so this is prepending zeros.
--> magShiftLimbs : Num -> List Num -> List Num
magShiftLimbs = n -> mag -> if (magIsZero mag) [] (prepend (replicate n 0) mag),

--> magMul : List Num -> List Num -> List Num
magMul = a -> b -> b
	> mapIndex (i -> limb -> magShiftLimbs i (magMulSmall limb a))
	> foldl magAdd [],

--> magDouble : List Num -> List Num
magDouble = magMulSmall 2,

--> magBitLength : List Num -> Num
magBitLength = mag -> if (magIsZero mag) 0
	(let top = lastOr 0 mag in add (mul limbBits (pred (length mag))) (bitLengthOf top)),

--> bitLengthOf : Num -> Num
bitLengthOf = n -> if (eq n 0) 0 (succ (bitLengthOf (div 2 n))),

--> magTestBit : Num -> List Num -> Num
magTestBit = i -> mag ->
	let limbIndex = div limbBits i in
		bit.bitAt (mod limbBits i) (nthOr 0 limbIndex mag),

-- divTwoByOne high low d: (high * 2^32 + low) / d, for high < d < 2^32, as
-- [quotient, remainder]. The numerator reaches 2^64, so this cannot be a single
-- division: it is a four-step long division in base 2^16, where a partial
-- remainder times 2^16 stays under 2^48 and so stays exact.
--> divTwoByOne : Num -> Num -> Num -> [Num, Num]
divTwoByOne = high -> low -> d ->
	let
		digits = [div halfBase high; mod halfBase high; div halfBase low; mod halfBase low],
		step = [quotient, remainder] -> digit ->
			let current = add (mul halfBase remainder) digit in
				[add (mul halfBase quotient) (div d current), mod d current]
	in
		foldl step [0, 0] digits,

-- magDivMod a b: [quotient, remainder], by schoolbook long division in base
-- 2^32 — Knuth's Algorithm D.
--
-- The dividend is consumed one limb at a time, most significant first, into a
-- running remainder that never exceeds the divisor's length by more than one
-- limb. Each step needs one quotient limb, which is *estimated* from the top
-- two limbs of the remainder over the top limb of the divisor and then
-- corrected downward.
--
-- Normalisation is what bounds that correction. Scaling both operands so the
-- divisor's top limb has its high bit set (which cannot change the quotient)
-- makes the estimate at most two too large — a theorem, not a heuristic — so
-- the correction loop runs at most twice regardless of the numbers. The
-- remainder is scaled back down at the end.
--
-- This replaced binary long division, which needed a pass per *bit* of the
-- dividend rather than per limb: a factor of 32 on the same operands.
--> magDivMod : List Num -> List Num -> [List Num, List Num]
magDivMod = a -> b ->
	-- magDivModSmall reports its remainder as a plain number, not a magnitude.
	--> bySmallDivisor : [List Num, List Num]
	let bySmallDivisor = magDivModSmall (headOr 0 b) a > ([quotient, remainder] -> [quotient, magFromNumber remainder]) in
		when       (magIsZero b)                    [[], []]        -- caller's error; no crash
		> elseWhen (eq (negate 1) (magCompare a b)) [[], a]         -- a < b
		> elseWhen (eq 1 (length b))                bySmallDivisor
		> default  (magDivModLarge a b),

--> magDivModLarge : List Num -> List Num -> [List Num, List Num]
magDivModLarge = a -> b ->
	let
		-- Normalise: shift left so the divisor's top limb has its high bit set.
		shift  = sub (bitLengthOf (lastOr 0 b)) limbBits,
		scale  = pow shift 2,
		an     = magMulSmall scale a,
		bn     = magMulSmall scale b,

		size   = length bn,
		topB   = lastOr 0 bn,

		-- One limb of the dividend, one limb of the quotient.
		step = [quotient, remainder] -> limb ->
			let
				current  = magAdd (magShiftLimbs 1 remainder) (if (eq limb 0) [] [limb;]),
				-- The two limbs the estimate is read from: current is at most one
				-- limb longer than the divisor, so these are its top two aligned
				-- against the divisor's length, or zero where it is shorter.
				high     = nthOr 0 size current,
				low      = nthOr 0 (pred size) current,
				estimate = if (gte topB high)
					(sub 1 base)                            -- saturated: clamp to base - 1
					(first (divTwoByOne high low topB)),
				corrected = lowerUntilFits estimate current bn
			in
				[[corrected, quotient], magSub current (magMulSmall corrected bn)],

		--> divided : [List Num, List Num]
		divided = foldl step [[], []] (reverse an)
	in
		[
			-- Each step conses its limb on, and the steps run most significant
			-- first, so the accumulated list is already least-significant first.
			normalize (first divided),
			first (magDivModSmall scale (second divided))    -- undo the normalisation
		],

-- Knuth's estimate is at most two too large once normalised, so this loop runs
-- at most twice; it is written as a loop rather than as two tests because the
-- bound is a property of the normalisation, not of this code.
--> lowerUntilFits : Num -> List Num -> List Num -> Num
lowerUntilFits = estimate -> remainder -> divisor ->
	if (eq estimate 0)
		0
		(if (gte 0 (magCompare remainder (magMulSmall estimate divisor)))
			estimate
			(lowerUntilFits (pred estimate) remainder divisor)),

-- magDivModSmall d mag: divide by a number in [1, 2^32). Works in 16-bit halves
-- because remainder * base would overflow the exact range of a float64.
--> magDivModSmall : Num -> List Num -> [List Num, Num]
magDivModSmall = d -> mag ->
	let
		halves = mag > flatMap (limb -> [mod halfBase limb; div halfBase limb]),

		--> rec : Num -> List Num -> [List Num, Num]
		rec = remainder -> hs -> hs > {
			[] -> [[], remainder],
			[h, rest] -> let
				current = add (mul halfBase remainder) h,
				--> rest2 : [List Num, Num]
				rest2   = rec (mod d current) rest
			in
				[[div d current, first rest2], second rest2]
		},

		--> divided : [List Num, Num]
		divided        = rec 0 (reverse halves),
		quotientHalves = reverse (first divided)
	in
		[
			quotientHalves
				> splitEqual 2
				> map (pair -> add (headOr 0 pair)
					(mul halfBase (nthOr 0 1 pair)))
				> normalize,
			second divided
		],

-- --- integers -------------------------------------------------------------

--> intZero : BigInt
intZero = [1, []],
--> intOne : BigInt
intOne  = [1, [1;]],

--> intSign : BigInt -> Num
intSign      = [sign, mag] -> if (magIsZero mag) 0 sign,
--> intMagnitude : BigInt -> List Num
intMagnitude = [sign, mag] -> mag,
--> intIsZero : BigInt -> Num
intIsZero    = [sign, mag] -> magIsZero mag,

-- intFromNumber n: from an integer-valued number; exact below 2^53.
--> intFromNumber : Num -> BigInt
intFromNumber = n -> if (lt 0 n)
	[negate 1, magFromNumber (negate n)]
	[1, magFromNumber n],

--> intNegate : BigInt -> BigInt
intNegate = [sign, mag] -> if (magIsZero mag) [1, mag] [negate sign, mag],
--> intAbs : BigInt -> BigInt
intAbs    = [sign, mag] -> [1, mag],

-- intCompare a b: -1, 0 or 1 as a is less than, equal to, or greater than b.
--> intCompare : BigInt -> BigInt -> Num
intCompare = a -> b ->
	let sa = intSign a, sb = intSign b in
		when       (neq sa sb) (if (lt sb sa) (negate 1) 1)
		> elseWhen (eq sa 0)   0
		> default  (mul sa (magCompare (intMagnitude a) (intMagnitude b))),

--> intAdd : BigInt -> BigInt -> BigInt
intAdd = a -> b -> a > ([sa, ma] -> b > ([sb, mb] ->
	if (eq sa sb)
		[sa, magAdd ma mb]
		(let c = magCompare ma mb in
			when       (eq c 0) intZero
			> elseWhen (eq c 1) [sa, magSub ma mb]      -- |a| > |b|
			> default           [sb, magSub mb ma]))),

-- intSub k n: n - k. The operand comes first and the value it applies to last,
-- exactly as the `sub` builtin does, so `n > intSub k` reads as "subtract k"
-- and the partial application is the useful one. The same holds for intDiv,
-- intMod, intDivMod, intPow and intPowMod below: a library that ordered these
-- mathematically would silently compute the reverse when piped into.
--> intSub : BigInt -> BigInt -> BigInt
intSub = k -> n -> intAdd n (intNegate k),

--> intMul : BigInt -> BigInt -> BigInt
intMul = a -> b -> a > ([sa, ma] -> b > ([sb, mb] ->
	let mag = magMul ma mb in
		if (magIsZero mag) intZero [mul sa sb, mag])),

-- intDivMod d n: [n / d, n mod d], truncating, the remainder taking the sign
-- of n — the convention of the div and mod builtins.
--> intDivMod : BigInt -> BigInt -> [BigInt, BigInt]
intDivMod = d -> n -> n > ([sa, ma] -> d > ([sb, mb] ->
	let
		--> divided : [List Num, List Num]
		divided   = magDivMod ma mb,
		quotient  = first divided,
		remainder = second divided
	in
		[
			if (magIsZero quotient) intZero [mul sa sb, quotient],
			if (magIsZero remainder) intZero [sa, remainder]
		])),

-- intDiv d n, intMod d n: the two halves of intDivMod.
--> intDiv : BigInt -> BigInt -> BigInt
intDiv = d -> intDivMod d *> first,
--> intMod : BigInt -> BigInt -> BigInt
intMod = d -> intDivMod d *> second,

--> intMulSmall : Num -> BigInt -> BigInt
intMulSmall = k -> [sign, mag] -> if (lt 0 k)
	[negate sign, magMulSmall (negate k) mag]
	(let m = magMulSmall k mag in if (magIsZero m) intZero [sign, m]),

-- intPow e b: b^e for a non-negative e, by squaring — the argument order of the
-- `pow` builtin, where `pow 2 x` is x squared.
--> intPow : Num -> BigInt -> BigInt
intPow = e -> b ->
	when       (eq e 0) intOne
	> elseWhen (even e) (let half = intPow (div 2 e) b in intMul half half)
	> default           (intMul b (intPow (pred e) b)),

-- intPowMod m e b: b^e mod m, for a non-negative exponent. Square-and-multiply
-- with a reduction at every step, so the operands stay the size of m instead of
-- growing to the size of b^e. Computing the power first and reducing afterwards
-- is the same answer and a different order of cost: 1000^1000 has 3001 digits.
--> intPowMod : BigInt -> Num -> BigInt -> BigInt
intPowMod = m -> e -> b ->
	when       (eq e 0) (intMod m intOne)
	> elseWhen (even e) (let half = intPowMod m (div 2 e) b in intMod m (intMul half half))
	> default           (intMod m (intMul b (intPowMod m (pred e) b))),

-- intPowModBig m e b: b^e mod m with the exponent itself an arbitrary-precision
-- integer. `intPowMod` takes a plain number, which caps the exponent at 2^53 —
-- and that is exactly where the interesting uses start: an RSA private exponent
-- is the size of the modulus, and passing it as a number makes `pred e` a no-op
-- and the recursion endless. This walks the exponent's bits instead, most
-- significant first, squaring at each step and multiplying where the bit is set.
--> intPowModBig : BigInt -> BigInt -> BigInt -> BigInt
intPowModBig = m -> e -> b ->
	let
		mag = intMagnitude e,
		rec = i -> acc -> if (lt 0 i)
			acc
			(let squared = intMod m (intMul acc acc) in
				rec (pred i) (if (eq 1 (magTestBit i mag))
					(intMod m (intMul squared b))
					squared))
	in
		if (intIsZero e) (intMod m intOne) (rec (pred (magBitLength mag)) intOne),

-- Threshold-first predicates, matching the lt/lte/gt/gte builtins: the
-- reference value comes first and the value under test last, so
-- `n > intLt limit` reads as "is n less than limit". intCompare is deliberately
-- *not* of this shape — a three-way result is not a predicate, and it answers
-- "how does a compare to b" in the usual order.
--> intLt : BigInt -> BigInt -> Num
intLt  = threshold -> value -> eq (negate 1) (intCompare value threshold),
--> intLte : BigInt -> BigInt -> Num
intLte = threshold -> value -> neq 1 (intCompare value threshold),
--> intGt : BigInt -> BigInt -> Num
intGt  = threshold -> value -> eq 1 (intCompare value threshold),
--> intGte : BigInt -> BigInt -> Num
intGte = threshold -> value -> neq (negate 1) (intCompare value threshold),

-- intToNumber: back to a plain number, losing exactness past 2^53.
--> intToNumber : BigInt -> Num
intToNumber = [sign, mag] -> mul sign
	(mag > foldr (limb -> acc -> add limb (mul base acc)) 0),

--> chunkDigits : Num
chunkDigits = 9,
--> chunkBase : Num
chunkBase   = 1000000000,      -- 10^9, the largest power of ten below 2^32

-- intToString: repeated division by 10^9, so nine decimal digits come out per
-- division rather than one.
--> intToString : BigInt -> List Num
intToString = [sign, mag] -> if (magIsZero mag) "0"
	(let
		-- The chunks are matched rather than taken apart with head and tail, so
		-- nothing here assumes the list is non-empty. The empty case cannot arise —
		-- magIsZero rules it out above — but handling it costs one line.
		body = magToChunks mag > {
			[] -> "",
			[hd, rest] -> flatten [
				string hd;
				rest > map (c -> padLeft chunkDigits (char '0') (string c)) > flatten
			]
		}
	in
		if (lt 0 sign) (prepend "-" body) body),

-- Most significant chunk first. The chunks come out least significant first, so
-- they are accumulated by prepending rather than appended to the recursive
-- result — appending copies the chunks built so far and makes printing a number
-- quadratic in its length.
-- One-liner equivalent: mag -> if (magIsZero mag) []
--   (let d = magDivModSmall chunkBase mag in append [second d;] (magToChunks (first d)))
--> magToChunks : List Num -> List Num
magToChunks = mag ->
	let gather = chunks -> m -> if (magIsZero m) chunks
		(--> divided : [List Num, Num]
		 let divided = magDivModSmall chunkBase m in
			gather [second divided, chunks] (first divided))
	in
		gather [] mag,

--> intFromString : List Num -> BigInt
intFromString = s -> s > {
	[] -> intZero,
	[c, rest] -> if (eq c (char '-'))
		(intNegate (intFromDigits rest))
		(intFromDigits [c, rest])
},

--> intFromDigits : List Num -> BigInt
intFromDigits = digits -> [1, digits
	> filter isDigit
	> foldl (acc -> c -> magAdd (magMulSmall 10 acc) (magFromNumber (digitToInt c))) []],

-- intDigits: the decimal digits, most significant first.
--> intDigits : BigInt -> List Num
intDigits = n -> intToString n > filter isDigit > map digitToInt,

-- --- floats ---------------------------------------------------------------
--
-- [mantissa, exponent, precision] means mantissa * 2^exponent, with the
-- mantissa held to `precision` significand bits.

--> BigFloat = [BigInt, Num, Num]

--> floatMantissa : BigFloat -> BigInt
floatMantissa  = [m, e, p] -> m,
--> floatExponent : BigFloat -> Num
floatExponent  = [m, e, p] -> e,
--> floatPrecision : BigFloat -> Num
floatPrecision = [m, e, p] -> p,

-- floatRound: bring a value back to its precision by dropping low bits of the
-- mantissa and raising the exponent to match. Truncation toward zero.
--> floatRound : BigFloat -> BigFloat
floatRound = [m, e, p] ->
	let excess = sub p (magBitLength (intMagnitude m)) in
		if (lt 1 excess)
			[m, e, p]
			(let shifted = first (intDivMod (intPow excess (intFromNumber 2)) m) in
				[shifted, add e excess, p]),

--> floatFromInt : Num -> BigInt -> BigFloat
floatFromInt = precision -> n -> floatRound [n, 0, precision],

-- floatFromNumber: a plain number keeps its fraction. Doubling is exact in
-- binary, so scaling up until the value is integral loses nothing, and the
-- count of doublings is the exponent. A float64 carries at most 52 fractional
-- bits, so this terminates well before the mantissa could overflow.
--> floatFromNumber : Num -> Num -> BigFloat
floatFromNumber = precision -> n ->
	let rec = value -> exponent -> if (isInteger value)
		(floatRound [intFromNumber value, exponent, precision])
		(rec (mul 2 value) (pred exponent))
	in
		rec n 0,

-- floatWithPrecision: the same value carried at a different precision.
--> floatWithPrecision : Num -> BigFloat -> BigFloat
floatWithPrecision = precision -> [m, e, p] -> floatRound [m, e, precision],

-- Align two floats on the lower exponent, so their mantissas can be combined.
--> floatAlign : BigFloat -> BigFloat -> [BigInt, BigInt, Num]
floatAlign = a -> b ->
	let
		ea = floatExponent a, eb = floatExponent b,
		low = min ea eb,
		lift = value -> exponent -> intMul (floatMantissa value)
			(intPow (sub low exponent) (intFromNumber 2))
	in
		[lift a ea, lift b eb, low],

--> floatAdd : BigFloat -> BigFloat -> BigFloat
floatAdd = a -> b -> floatAlign a b > ([ma, mb, e] ->
	floatRound [intAdd ma mb, e, max (floatPrecision a) (floatPrecision b)]),

-- floatSub k x: x - k, and floatDiv d x: x / d, ordered like their integer
-- counterparts and like the builtins.
--> floatSub : BigFloat -> BigFloat -> BigFloat
floatSub = k -> x -> floatAdd x (floatNegate k),

--> floatNegate : BigFloat -> BigFloat
floatNegate = [m, e, p] -> [intNegate m, e, p],

--> floatMul : BigFloat -> BigFloat -> BigFloat
floatMul = a -> b -> floatRound [
	intMul (floatMantissa a) (floatMantissa b),
	add (floatExponent a) (floatExponent b),
	max (floatPrecision a) (floatPrecision b)
],

-- floatDiv: shift the numerator up by enough bits that the quotient lands with
-- the requested precision, then divide the mantissas.
--> floatDiv : BigFloat -> BigFloat -> BigFloat
floatDiv = d -> a ->
	let
		b     = d,
		p     = max (floatPrecision a) (floatPrecision b),
		shift = add p (add 2 (sub (magBitLength (intMagnitude (floatMantissa a)))
			(magBitLength (intMagnitude (floatMantissa b))))),
		lifted = intMul (floatMantissa a) (intPow (max 0 shift) (intFromNumber 2))
	in
		floatRound [
			first (intDivMod (floatMantissa b) lifted),
			sub (max 0 shift) (sub (floatExponent b) (floatExponent a)),
			p
		],

--> floatCompare : BigFloat -> BigFloat -> Num
floatCompare = a -> b -> floatAlign a b > ([ma, mb, e] -> intCompare ma mb),

--> floatIsZero : BigFloat -> Num
floatIsZero = [m, e, p] -> intIsZero m,

-- The same threshold-first predicates for floats.
--> floatLt : BigFloat -> BigFloat -> Num
floatLt  = threshold -> value -> eq (negate 1) (floatCompare value threshold),
--> floatLte : BigFloat -> BigFloat -> Num
floatLte = threshold -> value -> neq 1 (floatCompare value threshold),
--> floatGt : BigFloat -> BigFloat -> Num
floatGt  = threshold -> value -> eq 1 (floatCompare value threshold),
--> floatGte : BigFloat -> BigFloat -> Num
floatGte = threshold -> value -> neq (negate 1) (floatCompare value threshold),

-- floatToString digits: a decimal rendering with that many places after the
-- point, truncated. The value is scaled by 10^digits as an exact integer first,
-- so the printed digits are the true ones rather than a repeated conversion.
--> floatToString : Num -> BigFloat -> List Num
floatToString = digits -> [m, e, p] ->
	let
		scaled  = intMul m (intPow digits (intFromNumber 10)),
		shifted = if (lt 0 e)
			(first (intDivMod (intPow (negate e) (intFromNumber 2)) scaled))
			(intMul scaled (intPow e (intFromNumber 2))),
		negative = eq (negate 1) (intSign shifted),
		text     = intToString (intAbs shifted),
		padded   = padLeft (succ digits) (char '0') text,
		point    = sub digits (length padded)
	in
		flatten [
			if negative "-" "";
			take point padded;
			".";
			drop point padded
		],

-- floatSqrt: Newton's method, x' = (x + v/x)/2, run until the step stops
-- changing the value at the working precision.
--> floatSqrt : BigFloat -> BigFloat
floatSqrt = value ->
	let
		p    = floatPrecision value,
		two  = floatFromNumber p 2,
		-- floatDiv is divisor-first: `floatDiv x value` is value / x.
		step = x -> floatDiv two (floatAdd x (floatDiv x value)),
		rec   = x -> let next = step x in
			if (eq 0 (floatCompare next x)) x (rec next)
	in
		if (floatIsZero value) value (rec (floatWithPrecision p value))
