-- comb.þ: combinatorics — subsets, permutations, and selections.
import list, math, core in

module

-- pairs l: every two-element sublist [a; b], a appearing before b in l.
-- These are lists, not tuples: `choose 2` is `choose` at n = 2, so the results
-- have the same shape at every n. `crossPairs` is the one that yields tuples.
--> pairs : List a -> List (List a)
pairs = choose 2,

-- subsets l: power set — all subsets of l (including empty, shortest first)
--> subsets : List a -> List (List a)
subsets = {
	[] -> [[];],
	[h, t] -> let ss = subsets t in prepend ss (map (cons h) ss)
},

-- subsetsWithRest n l: all ways to choose n elements, each result as [chosen, rest]
--> subsetsWithRest : Num -> List a -> List [List a, List a]
subsetsWithRest = {
	0 -> l -> [[[], l];],
	n -> {
		[] -> [],
		[h, t] ->
			prepend
				(map ([ch, r] -> [[h, ch], r]) (subsetsWithRest (pred n) t))
				(subsetsWithRest n t)
	}
},

-- choose n l: all n-element subsets of l
--> choose : Num -> List a -> List (List a)
choose = n -> l -> map first (subsetsWithRest n l),

-- crossPairs a b: Cartesian product — all tuples [x, y] with x from a, y from b
--> crossPairs : List a -> List b -> List [a, b]
crossPairs = a -> b -> flatten (map (x -> map (y -> [x, y]) b) a),

-- permutations l: all permutations of l
--> permutations : List a -> List (List a)
permutations = {
	[] -> [[];],
	l -> flatten (map (x -> map (cons x) (permutations (remove x l))) l)
}
