-- heap.þ: purely functional leftist heaps.
-- Provides O(log n) insert, merge, and pop.
-- This is a max-priority heap: the root is the element that "wins" the comparison.
-- Node structure: [rank, value, left, right]
-- where rank is the length of the right spine (the shortest path to an empty node).
--
-- Comparator convention: cmp a b = 1 means a beats b (a goes to root).
--   cmp = lt  →  a beats b when b < a  →  max-heap (largest at root)
--   cmp = gt  →  a beats b when b > a  →  min-heap (smallest at root)
-- Use the named helpers sortAsc / sortDesc to avoid thinking about this.
import core, math, list, maybe in

module

emptyHeap = [], -- the empty heap

isEmpty = { [] -> 1, h -> 0 }, -- 1 if heap is empty, else 0

singleton = value -> [1, value, [], []], -- a heap containing only one value

rankOf = { [] -> 0, [rank, value, left, right] -> rank }, -- shortest path to an empty node

-- makeNode value left right: internal helper to maintain leftist property (right rank <= left rank)
makeNode = value -> left -> right ->
	let
		rankLeft  = rankOf left,
		rankRight = rankOf right
	in
		if (gte rankRight rankLeft)
			[succ rankRight, value, left, right]
			[succ rankLeft, value, right, left],

-- merge cmp h1 h2: merge two heaps ($O(\log n)$)
merge = cmp -> {
	[] -> h2 -> h2,
	[rank1, value1, left1, right1] -> {
		[] -> [rank1, value1, left1, right1],
		[rank2, value2, left2, right2] ->
			if (cmp value1 value2)
				(makeNode value1 left1 (merge cmp right1 [rank2, value2, left2, right2]))
				(makeNode value2 left2 (merge cmp [rank1, value1, left1, right1] right2))
	}
},

insert = cmp -> x -> h -> merge cmp (singleton x) h, -- insert x into heap h ($O(\log n)$)

-- top h: return the root value; crashes on empty heap.
top = [rank, value, left, right] -> value,

-- topSafe h: return some value for the root, or none if empty.
topSafe = {
	[] -> maybe.none,
	[rank, value, left, right] -> maybe.some value
},

-- pop cmp h: remove the root and return the new heap; crashes on empty heap ($O(\log n)$).
pop = cmp -> [rank, value, left, right] -> merge cmp left right,

-- popSafe cmp h: return some (new heap) after removing the root, or none if empty.
popSafe = cmp -> {
	[] -> maybe.none,
	[rank, value, left, right] -> maybe.some (merge cmp left right)
},

fromList = cmp -> foldl (h -> x -> insert cmp x h) [], -- build a heap from a list

-- The node is matched here rather than reached through top and pop, which are
-- the partial pair: the empty case is already handled, so one destructuring
-- serves both fields and assumes nothing.
toList = cmp -> {
	[] -> [],
	[rank, value, left, right] -> [value, toList cmp (merge cmp left right)]
}, -- convert a heap to a sorted list

-- sortBy cmp l: heapsort using the provided comparator.
-- Use sortAsc / sortDesc for the common cases.
sortBy = cmp -> l -> toList cmp (fromList cmp l),

-- sortAsc l: sort ascending (smallest first), equivalent to list.sort.
sortAsc = sortBy gt,

-- sortDesc l: sort descending (largest first).
sortDesc = sortBy lt
