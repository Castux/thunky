-- Dump the token stream of the program on stdin: a lexer smoke test.
import core, list, math, text, lex in

let
	source = stdin,
	kindName = k -> nth k ["number"; "name"; "string"; "symbol"; "keyword"; "end"],
	render = [kind, value, offset] -> flatten [
		padLeft 4 space (string offset); "  ";
		padRight 8 space (kindName kind);
		if (eq kind lex.tokenNumber) (string value) (flatten [[dquote;]; value; [dquote;]])
	]
in
	lex.tokens source > map render > map write > eval
