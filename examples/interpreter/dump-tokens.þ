-- Dump the token stream of the program on stdin: a lexer smoke test.
import core, list, math, text, lex in

let
	source = stdin,
	kindName = k -> nth k ["number"; "name"; "string"; "symbol"; "keyword"; "end"],
	row = [kind, value, offset] -> [
		string offset;
		kindName kind;
		if (eq kind lex.tokenNumber) (string value) (format "%s%s%s" [[dquote;]; value; [dquote;]])
	]
in
	lex.tokens source > map row > writeTable
