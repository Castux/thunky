-- eval.th: the evaluator.
--
-- The interesting claim this file makes is that a lazy object language on a
-- lazy host needs no machinery for laziness at all.
--
--   * An application evaluates to `apply (eval env f) (eval env argument)`.
--     The host does not evaluate the argument to build that call, so the
--     object language is call-by-name for free — and because the host memoises
--     every value once forced, and the argument is one shared value, it is
--     call-by-*need*, not call-by-name. A strict host would need an explicit
--     thunk object and a mutable store to get the same thing.
--
--   * A `let` group is mutually recursive because its environment is defined in
--     terms of itself: each binding is evaluated in the very environment being
--     built. That knot is ordinary here and is what usually forces mutation.
--
--   * Matching a name pattern binds without forcing; matching a number or a
--     tuple pattern forces exactly as far as the shape it is testing. That
--     falls out of using host pattern matching to inspect the value, so the
--     object language's forcing rules are the host's.
--
-- Errors do not fall out for free. There are no exceptions, so `crash` writes a
-- message and then returns a value that is itself the crash — any use of it
-- re-reports. That is enough to see what went wrong, and it is the one place
-- where the absence of a control-flow escape really shows.

import core, list, math, text, maybe, hashmap, lex, parse, value in

module

-- --- environments ---------------------------------------------------------
--
-- A name to value map. Values in it may be unevaluated, which is the whole
-- point: binding is not evaluation.

emptyEnv = hashmap.empty,
bind     = name -> item -> hashmap.set name item,
bindAll  = pairs -> env -> foldl (acc -> [name, item] -> bind name item acc) env pairs,

lookupIn = env -> name -> hashmap.get name env,

-- --- failure --------------------------------------------------------------

crash = message -> seq (write (flatten ["runtime error: "; message]))
	(value.tupleValue []),

-- --- pattern matching -----------------------------------------------------
--
-- match pattern subject env: the extended environment, or none. A name pattern
-- forces nothing; the others force only as far as the shape they test.

match = [tag, contents] -> subject -> env ->
	when       (eq tag parse.patVar)    (maybe.some (bind contents subject env))
	> elseWhen (eq tag parse.patNumber) (if (isNumberEqual subject contents) (maybe.some env) maybe.none)
	> elseWhen (eq tag parse.patString) (matchAll (map (c -> [parse.patNumber, c]) contents > asListPattern)
		subject env)
	> default                           (matchTuple contents subject env),

-- The name pattern binds without forcing, so the subject is forced by
-- `isNumber` and not by getting here: a number pattern forces its subject to a
-- number and nothing else, which is the rule the object language states.
isNumberEqual = subject -> wanted -> subject > {
	number -> and (value.isNumber subject) (eq number wanted)
},

-- A string pattern is a list pattern over its code points, built here rather
-- than in the parser so that the parser's tree stays close to the source.
asListPattern = foldr (item -> rest -> [parse.patTuple, [item; rest]])
	[parse.patTuple, []],

matchTuple = subpatterns -> subject -> env -> subject > {
	[tag, items] -> if (and (eq tag value.valTuple) (eq (length subpatterns) (length items)))
		(matchItems subpatterns items env)
		maybe.none,
	other -> maybe.none
},

matchItems = subpatterns -> items -> env -> subpatterns > {
	[] -> maybe.some env,
	[pattern, morePatterns] -> items > {
		[item, moreItems] -> match pattern item env
			> maybe.andThen (extended -> matchItems morePatterns moreItems extended),
		other -> maybe.none
	}
},

matchAll = pattern -> subject -> env -> match pattern subject env,

-- --- application ----------------------------------------------------------

apply = function -> argument -> function > {
	[tag, cases, env] -> applyCases cases env argument,
	[tag, primitive, arity, collected] ->
		let gathered = append [argument;] collected in
			if (eq arity (length gathered))
				(runPrimitive primitive gathered)
				[value.valBuiltin, primitive, arity, gathered],
	other -> crash "cannot apply a value that is not a function"
},

applyCases = cases -> env -> argument -> cases > {
	[] -> crash "no pattern matched the argument",
	[[pattern, body], rest] -> match pattern argument env
		> maybe.mapDefault (applyCases rest env argument) (extended -> expression extended body)
},

-- --- evaluation -----------------------------------------------------------
--
-- Named `expression`, not `eval`: an unqualified import puts every binding of
-- this module into the importer's scope, and a binding called `eval` shadows
-- the builtin of that name. The driver's own `… > eval` then built a partial
-- application of *this* function and silently did nothing — no output, no
-- error. Finding 12 again, reached through a module this time.

expression = env -> node -> node > {
	[tag, contents] ->
		when       (eq tag parse.astNumber) contents
		> elseWhen (eq tag parse.astString) (value.fromText contents)
		> elseWhen (eq tag parse.astVar)    (lookupIn env contents
			> maybe.mapDefault (crash (flatten ["unbound name "; contents])) core.id)
		> elseWhen (eq tag parse.astTuple)  (value.tupleValue (map (expression env) contents))
		> elseWhen (eq tag parse.astLambda) [value.valClosure, contents, env]
		> default                           (crash "unknown expression"),

	[tag, a, b] ->
		-- The argument is passed unevaluated: this single line is where the
		-- object language's laziness comes from.
		when       (eq tag parse.astApply)     (apply (expression env a) (expression env b))
		> elseWhen (eq tag parse.astLet)       (expression (letEnv env a) b)
		-- `list.map` is bound under that very name alongside the unqualified
		-- one, so a qualified reference is an ordinary lookup and the
		-- environment stays flat.
		> elseWhen (eq tag parse.astQualified) (lookupIn env (flatten [a; "."; b])
			> maybe.mapDefault (crash (flatten ["unbound name "; a; "."; b])) core.id)
		> default                              (crash "unknown expression"),

	other -> crash "unknown expression"
},

-- The knot: every binding is evaluated in the environment that contains them
-- all, including itself. Laziness makes the definition legal and memoisation
-- makes it efficient.
letEnv = outer -> bindings ->
	let inner = bindings > foldl (acc -> [name, expr] -> bind name (expression inner expr) acc) outer
	in inner,

-- --- primitives -----------------------------------------------------------
--
-- Kept as an index into one list so that a builtin value carries a number
-- rather than a name, and so that arity lives in one place.

primitives = [
	["add", 2]; ["sub", 2]; ["mul", 2]; ["div", 2]; ["fdiv", 2]; ["mod", 2];
	["fmod", 2]; ["pow", 2]; ["sqrt", 1]; ["eq", 2]; ["lt", 2]; ["lte", 2];
	["gte", 2]; ["gt", 2]; ["neq", 2]; ["equal", 2]; ["seq", 2]; ["eval", 1];
	["peek", 1]; ["show", 1]; ["write", 1]; ["bwrite", 1]; ["string", 1]; ["hash", 1]
],

primitiveIndex = name -> findIndex ([primitiveName, arity] -> equal primitiveName name)
	primitives,

-- builtinValue name: the value a builtin name evaluates to, with no arguments
-- gathered yet.
builtinValue = name -> primitiveIndex name > maybe.fmap (index ->
	[value.valBuiltin, index, second (nth index primitives), []]),

-- Arguments arrive most recent first, so they are reversed before use.
-- `apply` appends each argument as it arrives, so they are already in source
-- order. An earlier version reversed them here, and every commutative primitive
-- hid it: `add 1 2` was right, while `sub 1 n` quietly computed 1 - n, so a
-- countdown ran away from its base case instead of toward it. It surfaced as
-- 92,000 evaluations of a three-step recursion.
runPrimitive = index -> collected ->
	let
		arguments = collected,
		one = head arguments,
		two = a -> nth 1 arguments,
		name = first (nth index primitives)
	in
		when       (equal name "add")  (numeric2 add arguments)
		> elseWhen (equal name "sub")  (numeric2 sub arguments)
		> elseWhen (equal name "mul")  (numeric2 mul arguments)
		> elseWhen (equal name "div")  (numeric2 div arguments)
		> elseWhen (equal name "fdiv") (numeric2 fdiv arguments)
		> elseWhen (equal name "mod")  (numeric2 mod arguments)
		> elseWhen (equal name "fmod") (numeric2 fmod arguments)
		> elseWhen (equal name "pow")  (numeric2 pow arguments)
		> elseWhen (equal name "sqrt") (sqrt (forceNumber one))
		> elseWhen (equal name "eq")   (numeric2 eq arguments)
		> elseWhen (equal name "lt")   (numeric2 lt arguments)
		> elseWhen (equal name "lte")  (numeric2 lte arguments)
		> elseWhen (equal name "gte")  (numeric2 gte arguments)
		> elseWhen (equal name "gt")   (numeric2 gt arguments)
		> elseWhen (equal name "neq")  (numeric2 neq arguments)
		> elseWhen (equal name "equal") (if (deepEqual (head arguments) (nth 1 arguments)) 1 0)
		> elseWhen (equal name "seq")  (seq (forceValue (head arguments)) (nth 1 arguments))
		> elseWhen (equal name "eval") (seq (value.render one) one)
		> elseWhen (equal name "peek") (seq (write (value.render one)) one)
		> elseWhen (equal name "show") (seq (write (value.render one)) one)
		> elseWhen (equal name "write") (seq (write (textOf one)) one)
		> elseWhen (equal name "bwrite") (seq (bwrite (textOf one)) one)
		> elseWhen (equal name "string") (value.fromText (value.render one))
		> default                      (hash (value.render one)),

numeric2 = operation -> arguments ->
	operation (forceNumber (head arguments)) (forceNumber (nth 1 arguments)),

forceNumber = subject -> subject > {
	number -> if (value.isNumber subject) number
		(crash "expected a number")
},

-- forceValue: to weak head normal form, which for these values means far
-- enough to know which of the four shapes it is.
forceValue = subject -> seq (value.classify subject) subject,

-- deepEqual: structural equality, forcing as it goes, like the builtin.
deepEqual = a -> b -> [value.classify a, value.classify b] > {
	[left, right] -> if (neq left right) 0
		(if (eq left value.valNumber) (if (eq a b) 1 0)
		(if (eq left value.valTuple)
			(let x = value.itemsOf a, y = value.itemsOf b in
				if (neq (length x) (length y)) 0
					(zipWith deepEqual x y > andList))
			0))
},

-- textOf: a list value of code points, as host text, for `write`.
textOf = subject -> value.listItems subject > map forceNumber
