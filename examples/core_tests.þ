	assert "list.splitEqual-exact" (list.splitEqual 2 [1; 2; 3; 4]) [[1; 2]; [3; 4]];
	assert "list.spans-count" (length (list.spans [1; 2; 3])) 4;
	assert "list.spans-first" (head (list.spans [1; 2])) [[], [1; 2]];
	assert "list.spans-last" (last (list.spans [1; 2])) [[1; 2], []];
	assert "list.zipWith3" (list.zipWith3 (a -> b -> c -> add a (add b c)) [1; 2] [10; 20] [100; 200]) [111; 222];
	assert "list.zipWith3-ragged" (list.zipWith3 (a -> b -> c -> add a (add b c)) [1; 2] [10;] [100; 200]) [111;];
	assert "list.iterate" (list.iterate (mul 2) 1 > take 4) [1; 2; 4; 8];
	assert "list.downFrom" (list.downFrom 3 > take 3) [3; 2; 1];
	assert "list.repeat" (list.repeat 7 > take 3) [7; 7; 7];
	assert "list.cycle" (list.cycle [1; 2] > take 5) [1; 2; 1; 2; 1];

	-- comb ------------------------------------------------------------------
	assert "comb.subsetsWithRest-count" (length (comb.subsetsWithRest 2 [1; 2; 3])) 3;
	assert "comb.subsetsWithRest-shape" (head (comb.subsetsWithRest 1 [1; 2])) [[1;], [2;]];

	-- heap ------------------------------------------------------------------
	assert "heap.popSafe-empty" (heap.popSafe lt heap.emptyHeap) maybe.none;
	assert "heap.popSafe-some" (heap.popSafe lt (heap.singleton 5) > maybe.value > heap.toList lt) [];

	-- table -----------------------------------------------------------------
	assert "table.fromList" (table.fromList [[1, 10]; [2, 20]] > table.get 2) (maybe.some 20);
	assert "table.toList" (table.toList (table.fromList [[1, 10];])) [[1, 10];];

	-- hashmap ---------------------------------------------------------------
	assert "hashmap.update-present"
		(hashmap.empty > hashmap.set 1 10 > hashmap.update 1 (add 5) > hashmap.get 1)
		(maybe.some 15);
	assert "hashmap.update-missing"
		(hashmap.empty > hashmap.set 1 10 > hashmap.update 2 (add 5) > hashmap.get 2)
		maybe.none;
	assert "hashmap.updateOr-present"
		(hashmap.empty > hashmap.set 1 10 > hashmap.updateOr 1 (add 5) 99 > hashmap.get 1)
		(maybe.some 15);
	assert "hashmap.updateOr-missing"
		(hashmap.empty > hashmap.updateOr 2 (add 5) 99 > hashmap.get 2)
		(maybe.some 99);

	-- bit -------------------------------------------------------------------
	assert "bit.width" bit.width 32;
	assert "bit.size" bit.size 4294967296;
	assert "bit.maxValue" bit.maxValue 4294967295;
	assert "bit.bitAt-low" (bit.bitAt 0 1) 1;
	assert "bit.bitAt-high" (bit.bitAt 1 1) 0;
	assert "bit.bitAt-eq-testBit" (bit.bitAt 3 8) (bit.testBit 3 8);
	assert "bit.flipBit-set" (bit.flipBit 0 0) 1;
	assert "bit.flipBit-clear" (bit.flipBit 0 1) 0;

	-- text ------------------------------------------------------------------
	assert "text.isLower-true" (text.isLower (text.char "a")) 1;
	assert "text.isLower-false" (text.isLower (text.char "A")) 0;
	assert "text.isUpper-true" (text.isUpper (text.char "Z")) 1;
	assert "text.isUpper-false" (text.isUpper (text.char "z")) 0;
	assert "text.isAlpha-letter" (text.isAlpha (text.char "q")) 1;
	assert "text.isAlpha-digit" (text.isAlpha (text.char "7")) 0;
	assert "text.isAlphaNum-letter" (text.isAlphaNum (text.char "q")) 1;
	assert "text.isAlphaNum-digit" (text.isAlphaNum (text.char "7")) 1;
	assert "text.isAlphaNum-other" (text.isAlphaNum (text.char "-")) 0;
	assert "text.digitToInt" (text.digitToInt (text.char "5")) 5;
	assert "text.intToDigit" (text.intToDigit 5) (text.char "5");
	assert "text.digit-roundtrip" (text.digitToInt (text.intToDigit 3)) 3;
	assert "text.nul" text.nul 0;
	assert "text.tab" text.tab 9;
	assert "text.cr" text.cr 13;
	assert "text.esc" text.esc 27;
	assert "text.space" text.space 32;
	assert "text.dquote" text.dquote 34;
	assert "text.quote" text.quote 39;
	assert "text.backslash" text.backslash 92;

	-- json ------------------------------------------------------------------
	assert "json.typeOf-number" (json.parse "5" > maybe.value > json.typeOf) "number";
	assert "json.typeOf-object" (json.parse "{}" > maybe.value > json.typeOf) "object";
	assert "json.jsonNull" (json.stringify json.jsonNull) "null";
	assert "json.jsonTrue" (json.stringify json.jsonTrue) "true";
	assert "json.jsonFalse" (json.stringify json.jsonFalse) "false";
	assert "json.jsonBool" (json.stringify (json.jsonBool 1)) "true";
	assert "json.jsonNumber" (json.stringify (json.jsonNumber 42)) "42";
	assert "json.jsonArray" (json.stringify (json.jsonArray [json.jsonNumber 1; json.jsonNumber 2])) "[1,2]";
	assert "json.jsonObject" (json.stringify (json.jsonObject [["a", json.jsonNumber 1];])) '{"a":1}';
	assert "json.asNumber" (json.parse "7" > maybe.value > json.asNumber) (maybe.some 7);
	assert "json.asArray-count"
		(json.parse "[1,2,3]" > maybe.value > json.asArray > maybe.value > length) 3;
	assert "json.asArray-wrong-type" (json.parse "7" > maybe.value > json.asArray) maybe.none;
	assert "json.asObject-count"
		(json.parse '{"a":1}' > maybe.value > json.asObject > maybe.value > length) 1;
	assert "json.toTable"
		(json.parse '{"a":1}' > maybe.value > json.toTable > table.get "a" > maybe.value > json.asNumber)
		(maybe.some 1);
	assert "json.stringifyPretty"
		(json.parse "[1,2]" > maybe.value > json.stringifyPretty 2)
		(text.unlines ["["; "  1,"; "  2"; "]"] > text.trim);

	-- big: integers ---------------------------------------------------------
	assert "big.intZero" (big.intToString big.intZero) "0";
	assert "big.intOne" (big.intToString big.intOne) "1";
	assert "big.intToNumber" (big.intToNumber (big.intFromNumber 12345)) 12345;
	assert "big.intNegate" (big.intToString (big.intNegate (big.intFromNumber 7))) "-7";
	assert "big.intAbs" (big.intToString (big.intAbs (big.intFromNumber 7 > big.intNegate))) "7";
	assert "big.intSign-pos" (big.intSign (big.intFromNumber 7)) 1;
	assert "big.intSign-neg" (big.intSign (big.intFromNumber 7 > big.intNegate)) (math.negate 1);
	assert "big.intSign-zero" (big.intSign big.intZero) 0;
	assert "big.intIsZero-true" (big.intIsZero big.intZero) 1;
	assert "big.intIsZero-false" (big.intIsZero big.intOne) 0;
	assert "big.intMulSmall" (big.intToString (big.intMulSmall 3 (big.intFromNumber 14))) "42";
	assert "big.intDivMod" (big.intDivMod (big.intFromNumber 7) (big.intFromNumber 30)
		> (x -> [big.intToString (first x), big.intToString (second x)])) ["4", "2"];
	assert "big.intGt" (big.intFromNumber 9 > big.intGt (big.intFromNumber 5)) 1;
	assert "big.intLte" (big.intFromNumber 5 > big.intLte (big.intFromNumber 5)) 1;

	-- big: floats -----------------------------------------------------------
	assert "big.floatFromInt"
		(big.floatToString 2 (big.floatFromInt 64 (big.intFromNumber 3))) "3.00";
	assert "big.floatWithPrecision"
		(big.floatToString 2 (big.floatWithPrecision 128 (big.floatFromNumber 64 2.5))) "2.50";
	assert "big.floatSub"
		(big.floatToString 2 (big.floatSub (big.floatFromNumber 64 1.5) (big.floatFromNumber 64 4))) "2.50";
	assert "big.floatNegate"
		(big.floatToString 2 (big.floatNegate (big.floatFromNumber 64 2.5))) "-2.50";
	assert "big.floatIsZero-true" (big.floatIsZero (big.floatFromNumber 64 0)) 1;
	assert "big.floatIsZero-false" (big.floatIsZero (big.floatFromNumber 64 1)) 0;
	assert "big.floatCompare-lt"
		(big.floatCompare (big.floatFromNumber 64 1) (big.floatFromNumber 64 2)) (math.negate 1);
	assert "big.floatCompare-eq"
		(big.floatCompare (big.floatFromNumber 64 2) (big.floatFromNumber 64 2)) 0;
	assert "big.floatLt" (big.floatFromNumber 64 1 > big.floatLt (big.floatFromNumber 64 2)) 1;
	assert "big.floatLte" (big.floatFromNumber 64 2 > big.floatLte (big.floatFromNumber 64 2)) 1;
	assert "big.floatGt" (big.floatFromNumber 64 3 > big.floatGt (big.floatFromNumber 64 2)) 1;
	assert "big.floatGte" (big.floatFromNumber 64 2 > big.floatGte (big.floatFromNumber 64 2)) 1;

	-- core constants used structurally by core.case --------------------------
	assert "core.true" (core.case core.true 1 else 0) 1;
	assert "core.false" (core.case core.false 1 else 0) 0
]
