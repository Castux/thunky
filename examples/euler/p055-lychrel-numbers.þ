-- Project Euler 55: Lychrel numbers
-- How many numbers below ten thousand never produce a palindrome under fifty
-- iterations of reverse-and-add.
-- Answer: 249
--
-- Fifty rounds of doubling the magnitude takes a four-digit start past thirty
-- digits, so the arithmetic is `big` throughout. Reversal goes through the
-- decimal rendering, which is also what the palindrome test compares — the
-- number's digits are the thing being asked about, so a string is the honest
-- representation for both.

import core, list, math, text, big in

let
	reverseDigits = big.intToString *> reverse *> big.intFromString,

	isPalindrome = big.intToString *> ap equal reverse,

	-- Lychrel until proven otherwise: fifty additions without a palindrome.
	isLychrel = start ->
		let step = remaining -> n -> case
			(eq remaining 0)   1
			else               (let next = big.intAdd n (reverseDigits n) in
				if (isPalindrome next) 0 (step (pred remaining) next))
		in
			step 50 (big.intFromNumber start)
in
	range 1 10000 > count isLychrel > show
