-- Project Euler 29: Distinct powers
-- How many distinct terms a^b produces for 2 <= a,b <= 100.
-- Answer: 9183
--
-- 100^100 has 201 digits, so the terms are `big` integers. Counting distinct
-- ones by `nub` would be O(n^2) structural comparisons of 200-digit numbers;
-- a hashmap keyed by the value itself is one hash and one O(log n) insert each,
-- and `hash` works on any value, bigints included.

import core, list, math, comb, hashmap, big in

	comb.crossPairs (rangeIncl 2 100) (rangeIncl 2 100)
	> map ([a, b] -> big.intPow b (big.intFromNumber a))
	> foldl (seen -> value -> hashmap.set value 1 seen) hashmap.empty
	> hashmap.keys
	> length
	> show
