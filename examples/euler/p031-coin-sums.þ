-- Project Euler 31: Coin sums
-- How many ways £2 can be made from the eight British coins.
-- Answer: 73682
--
-- The textbook solution is a table updated in place: for each coin, ways[i] +=
-- ways[i - coin], read from the row being written. That self-reference is the
-- whole algorithm, and it is usually what makes it need mutation.
--
-- Here the row simply refers to itself. `current` is defined in terms of
-- `nth (i - coin) current`, an earlier element of the list being defined, and
-- laziness resolves it in exactly the order the imperative loop would.

import core, list, math in

let
	coins  = [1; 2; 5; 10; 20; 50; 100; 200],
	target = 200,

	addCoin = previous -> coin ->
		let current = previous > mapIndex (i -> ways ->
			if (lt coin i) ways (add ways (nth (sub coin i) current)))
		in
			current,

	-- One way to make nothing; no ways to make anything else, before any coin.
	initial = prepend [1;] (replicate target 0)
in
	foldl addCoin initial coins > last > show
