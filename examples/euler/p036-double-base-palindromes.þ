-- Project Euler 36: Double-base palindromes
-- The sum of numbers below a million that read the same in base 10 and base 2.
-- Answer: 872187
--
-- Only odd numbers need testing: a binary palindrome cannot end in 0 unless it
-- is 0 itself, so every even candidate fails on its last bit. `bit.toBits`
-- gives a fixed 32 bits, least significant first, so reversing and dropping the
-- leading zeros is the binary rendering.

import core, list, math, text, bit in

let
	isPalindrome = ap equal reverse,

	binaryDigits = bit.toBits *> reverse *> dropWhile (eq 0)
in
	range 1 1000000
	> filter odd
	> filter (fork and (string *> isPalindrome) (binaryDigits *> isPalindrome))
	> sum
	> show
