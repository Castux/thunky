-- dijkstra.þ
--
-- Single-source shortest paths with a purely functional priority queue.
--
-- The classic imperative Dijkstra keeps a mutable distance array and a
-- decrease-key operation. Neither exists here, so this uses the standard
-- functional formulation instead:
--
--   * the frontier is a `heap` of [distance, node, reversed path] triples,
--     ordered by distance with `on gt distanceOf` — recall that `cmp a b = 1`
--     means "a goes to the root", and `gt a b = 1` when b > a, so this makes
--     the *smallest* distance win: a min-heap;
--   * there is no decrease-key. A node is simply inserted again with its new,
--     shorter distance, and the stale copies are skipped when they surface —
--     the first time a node comes off the heap it is final, because everything
--     still queued is at least as far away;
--   * `visited` is a `table` from node to final distance, and doubles as the
--     result. Tables are association lists: O(n) lookup, fine for a graph this
--     size. Swap in `hashmap` (same interface) when n gets large.
--
-- The search returns a *lazy* list of settled nodes in distance order, so
-- `takeWhile`/`find` over it stops the search early: asking only for "F"
-- never settles the nodes beyond it.

import core, list, math, maybe, text, heap, table in

let

	-- The graph: [node, [[neighbour, weight]; …]] entries. Undirected, so every
	-- edge appears in both adjacency lists.

	graph = [
		["A", [["B", 7]; ["C", 9]; ["F", 14]]];
		["B", [["A", 7]; ["C", 10]; ["D", 15]]];
		["C", [["A", 9]; ["B", 10]; ["D", 11]; ["F", 2]]];
		["D", [["B", 15]; ["C", 11]; ["E", 6]]];
		["E", [["D", 6]; ["F", 9]; ["G", 3]]];
		["F", [["A", 14]; ["C", 2]; ["E", 9]]];
		["G", [["E", 3];]];        -- one neighbour: a 1-element *list*, so the ';' is required
		["H", []]
	],

	source = "A",

	neighbours = node -> table.getOr [] node graph,

	-- Min-heap on the distance field of the [dist, node, path] triple.
	-- (core.first only reads 2-tuples, hence the explicit accessor.)
	distanceOf = [dist, node, path] -> dist,
	byDistance = on gt distanceOf,

	-- One settled node per step. The heap may hold several entries for the same
	-- node; the first to surface is the shortest, so later ones are dropped.

	search = visited -> frontier -> frontier > {
		[] -> [],
		h -> heap.top h > ([dist, node, path] ->
			let rest = heap.pop byDistance h in
				if (table.containsKey node visited)
					(search visited rest)
					(let
						visited2 = table.set node dist visited,
						frontier2 = neighbours node > foldl
							(queue -> [nbr, weight] ->
								heap.insert byDistance [add dist weight, nbr, [nbr, path]] queue)
							rest
					in
						[[node, dist, reverse path], search visited2 frontier2]))
	},

	-- The result is a lazy list, so it is built only as far as it is consumed.
	settled = search table.empty (heap.singleton [0, source, [source;]]),

	-- Reporting -------------------------------------------------------------

	row = [node, dist, path] -> flatten [
		text.padRight 6 text.space node;
		text.padLeft 5 text.space (string dist);
		"   ";
		text.join " -> " path
	],

	pathTo = target -> settled
		> find ([node, dist, path] -> equal node target)
		> maybe.mapDefault
			(flatten ["no route from "; source; " to "; target])
			([node, dist, path] -> flatten [
				"best "; source; " -> "; node; " costs "; string dist;
				" via "; text.join " -> " path
			]),

	report = flatten [
		[text.format "shortest paths from %s:" [source;]; "node    dist   path"];
		map row settled;
		[text.format "%v of %v nodes reachable" [length settled; length graph];];
		[pathTo "G"; pathTo "H"]     -- H is isolated: no route, and the search still terminates
	]

in
	report > text.writeList
