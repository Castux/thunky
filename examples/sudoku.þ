import core, maybe, list, math, text, hashmap in

let

	rowOf = div 9,
	colOf = mod 9,
	boxOf = fork add (rowOf *> div 3 *> mul 3) (colOf *> div 3),

	rowCells = r -> drop (mul r 9) *> take 9,

	-- Peer-index lists for all 81 cells, precomputed once at startup.
	peerList = i -> let r = rowOf i, c = colOf i, b = boxOf i in
		rangeIncl 0 80 > filter (j ->
			not (eq i j) > and
			(eq r (rowOf j) > or (eq c (colOf j)) > or (eq b (boxOf j)))),

	peersMap = rangeIncl 0 80 > map (i -> [i, peerList i]) > hashmap.fromList,

	-- Non-zero values of all peer cells via O(log 81) index lookups.
	peerValues = board -> i ->
		hashmap.get i peersMap > maybe.value
		> map (j -> hashmap.getOr 0 j board)
		> filter (equal 0 *> not),

	-- Solver state: [boardMap, emptiesList]
	solutions = [board, empties] -> empties > {
		[] -> [[board, empties];],
		[emptyIdx, rest] ->let
			invalid = peerValues board emptyIdx
		in
			rangeIncl 1 9
			> filter (d -> contains d invalid > not)
			> map (d -> solutions [hashmap.set emptyIdx d board, rest])
			> flatten
	},

	boardList = board -> rangeIncl 0 80 > map (i -> hashmap.getOr 0 i board),

	cellStr = { 0 -> ".", n -> string n },

	rowStr = r -> board ->
		let cells = map cellStr (rowCells r board) in
			flatten [
				text.join " " (take 3 cells);
				" | ";
				text.join " " (take 3 (drop 3 cells));
				" | ";
				text.join " " (drop 6 cells);
				[text.lf;]
			],

	sepLine = prepend "------+-------+------" [text.lf;],

	boardStr = board ->
		rangeIncl 0 8
		> map (r -> rowStr r board > prepend (if (or (eq r 3) (eq r 6)) sepLine []))
		> flatten

in

let puzzle = [
	5; 3; 0; 0; 7; 0; 0; 0; 0;
	6; 0; 0; 1; 9; 5; 0; 0; 0;
	0; 9; 8; 0; 0; 0; 0; 6; 0;
	8; 0; 0; 0; 6; 0; 0; 0; 3;
	4; 5; 0; 8; 0; 3; 0; 0; 1;
	7; 0; 0; 0; 0; 0; 0; 0; 6;
	0; 6; 0; 0; 0; 0; 2; 8; 0;
	0; 0; 0; 4; 1; 9; 0; 0; 5;
	0; 0; 0; 0; 8; 0; 0; 7; 9
] in

let
	initBoard   = zip (rangeIncl 0 80) puzzle > hashmap.fromList,
	initEmpties = zip (rangeIncl 0 80) puzzle > filter (second *> eq 0) > map first
in

eval < map write < prepend
	["Puzzle:"; boardStr puzzle; "Solutions:"]
	(solutions [initBoard, initEmpties] > map ([b, _] -> boardStr (boardList b)))
