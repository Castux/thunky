-- Rosetta Code: 99 bottles of beer

import core, list, math, text in

let
	bottles = { 0 -> "no more bottles", 1 -> "1 bottle", n -> flatten [string n; " bottles"] },

	verse = n -> [
		flatten [bottles n; " of beer on the wall, "; bottles n; " of beer."];
		flatten ["Take one down and pass it around, "; bottles (pred n);
			" of beer on the wall."];
		""
	]
in
	downFrom 99 > take 99 > flatMap verse > map write > eval
