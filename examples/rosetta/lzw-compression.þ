-- Rosetta Code: LZW compression
-- "TOBEORNOTTOBEORTOBEORNOT" compresses to
-- [84; 79; 66; 69; 79; 82; 78; 79; 84; 256; 258; 260; 265; 259; 261; 263].
--
-- Both directions grow a dictionary as they go, and neither transmits it. The
-- encoder maps strings to codes, the decoder codes to strings, so each uses a
-- hashmap keyed by whichever side it looks up — `hash` works on a list of code
-- points as readily as on a number.
--
-- The decoder needs the one special case LZW always needs: a code can refer to
-- an entry that is only being created by this very step, which happens exactly
-- when the encoder emitted a run like cScSc. Then the entry is the previous
-- string plus its own first character.

import core, list, math, text, maybe, hashmap in

let
	firstCode = 256,

	encodeDictionary = rangeIncl 0 255
		> foldl (dict -> c -> hashmap.set [c;] c dict) hashmap.empty,

	encode = text ->
		let
			rec = dict -> nextCode -> current -> input -> input > {
				[] -> if (isEmpty current) [] [hashmap.getOr 0 current dict;],
				[c, rest] ->
					let candidate = append [c;] current in
						hashmap.get candidate dict > {
							[known] -> rec dict nextCode candidate rest,
							[] -> [
								hashmap.getOr 0 current dict,
								rec (hashmap.set candidate nextCode dict) (succ nextCode) [c;] rest
							]
						}
			}
		in
			rec encodeDictionary firstCode [] text,

	decodeDictionary = rangeIncl 0 255
		> foldl (dict -> c -> hashmap.set c [c;] dict) hashmap.empty,

	decode = codes -> codes > {
		[] -> [],
		[firstOne, rest] ->
			let
				start = hashmap.getOr [] firstOne decodeDictionary,

				rec = dict -> nextCode -> previous -> input -> input > {
					[] -> [],
					[code, more] ->
						let
							-- The entry is either already known, or is the one this
							-- step is about to create: previous plus its own head.
							entry = hashmap.get code dict
								> maybe.default (append [head previous;] previous),
							grown = hashmap.set nextCode (append [head entry;] previous) dict
						in
							[entry, rec grown (succ nextCode) entry more]
				}
			in
				prepend start (flatten (rec decodeDictionary firstCode start rest))
	},

	sample   = "TOBEORNOTTOBEORTOBEORNOT",
	expected = [84; 79; 66; 69; 79; 82; 78; 79; 84; 256; 258; 260; 265; 259; 261; 263],
	codes    = encode sample,

	roundTrip = ap equal (encode *> decode)
in
	[
		prepend "input:    " sample;
		format "codes:    %v" [codes;];
		format "expected: %v" [expected;];
		format "matches:  %v" [equal codes expected;];
		prepend "decoded:  " (decode codes);
		format "round trips: %v"
			[["banana"; "aaaaaa"; "x"; ""; sample] > allMatch roundTrip;]
	] > writeList
