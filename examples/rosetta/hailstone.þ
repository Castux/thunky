-- Rosetta Code: Hailstone sequence (Collatz)
-- The sequence for 27 has 112 elements; the longest start below 10000 is 6171,
-- whose sequence has 262 elements.

import core, list, math, text in

let
	next = n -> if (even n) (div 2 n) (succ (mul 3 n)),

	hailstone = n -> append [1;] (takeWhile (neq 1) (iterate next n)),

	lengthsBelow = limit -> range 1 limit > map (n -> [n, length (hailstone n)]),

	-- Threshold-first: `gt a b` is 1 when b > a, so this keeps the candidate
	-- when it is longer than the best so far. Writing `lt` here reads as
	-- "best < candidate" and means the opposite; it silently returns [1, 1].
	longest = lengthsBelow 10000 > foldl (best -> candidate ->
		if (gt (second best) (second candidate)) candidate best) [1, 1],

	sequence27 = hailstone 27
in
	[
		format "27: length %v" [length sequence27;];
		format "    first 4 %v  last 4 %v"
			[take 4 sequence27; drop (sub 4 (length sequence27)) sequence27];
		format "longest below 10000: %v with %v elements" [first longest; second longest]
	] > writeList
