-- life.þ
--
-- Conway's Life, animated in the terminal.
--
--   thunky examples/life.þ
--
-- Terminal only: it drives the cursor with ANSI escape sequences, so it needs a
-- real terminal (at least 80x26) and not the playground's output pane. Stop it
-- early with Ctrl-C.
--
-- Two things are worth reading here.
--
-- **The simulation is a stream.** `iterate step soup` is the infinite sequence
-- of generations; nothing decides in advance how many to compute, and the
-- animation loop simply consumes one cell of it per frame. The board is never
-- mutated — each generation is a new value built from the previous one, and the
-- old one stays available, which is what lets the renderer colour a cell by
-- comparing it against the frame before.
--
-- **The step function never indexes the grid.** Counting neighbours by looking
-- up cell [x±1, y±1] would be O(n) per lookup on a cons list and hopeless.
-- Instead each generation is computed by *shifting whole rows*: the 3x3
-- neighbourhood sum is a horizontal `zipWith3` of every row against its two
-- rotations, then a vertical `zipWith3` of that grid against its two rotations.
-- Nine additions per cell, no indexing, and the rotations give a torus for free.
-- Then the rule needs no subtraction: the 3x3 sum includes the cell itself, so a
-- cell lives iff the sum is 3, or the sum is 4 and it was already alive.
--
-- **There is no clock.** The language has no sleep and no way to observe time,
-- so the frame rate comes from `spin`, a counted loop that does nothing. It is
-- calibrated by machine speed, not by seconds: lower `frameDelay` if the
-- animation crawls, raise it if it blurs. Computing and drawing a frame already
-- costs around 60 ms, so the delay is a top-up rather than the whole budget.

import core, list, math, maybe, text in

let
	--> width : Num
	width      = 40,          -- cells; each is drawn two columns wide
	--> height : Num
	height     = 24,
	--> frames : Num
	frames     = 300,
	--> frameDelay : Num
	frameDelay = 30000,       -- ~20 ms on an i7-6700K, on top of ~60 ms of work
	--> density : Num
	density    = 32,          -- percentage of cells alive in the initial soup
	--> seed : List Num
	seed       = "thunky",

	-- ANSI control ----------------------------------------------------------
	--
	-- Escape sequences are plain text: ESC, '[', parameters, a final letter.
	-- `bwrite` emits them without the newline `write` would add.

	-- The cursor is deliberately *not* hidden. A pure program has no signal
	-- handler and no exit hook, so anything it switches on may never be switched
	-- off: Ctrl-C during the animation would leave the terminal with an
	-- invisible cursor. Only escapes that are harmless to abandon are used here.

	--> csi : List Num
	csi        = flatten [[esc;]; "["],
	--> sgr : Num -> List Num
	sgr        = n -> flatten [csi; string n; "m"],
	--> home : List Num
	home       = flatten [csi; "H"],
	--> clear : List Num
	clear      = flatten [csi; "2J"],

	--> born : List Num
	born       = sgr 96,      -- bright cyan: alive now, dead in the previous frame
	--> survivor : List Num
	survivor   = sgr 32,      -- green: alive in both
	--> plain : List Num
	plain      = sgr 0,

	-- The initial soup ------------------------------------------------------
	--
	-- `hash` iterated on itself is the same cheap pseudorandom stream that
	-- examples/random-chisquare.þ tests; here it only has to look disordered.

	--> soup : List (List Num)
	soup = iterate hash (hash seed)
		> map (n -> if (lt density (mod 100 n)) 1 0)
		> take (mul width height)
		> splitEqual width,

	-- One generation --------------------------------------------------------

	-- Both are total: taking and dropping handle the empty list, where head/tail
	-- and last/init would each have needed an assumption the grid's size makes
	-- true but the type cannot state.
	--> rotateLeft : List a -> List a
	rotateLeft  = l -> append (take 1 l) (drop 1 l),   -- [a; b; c] -> [b; c; a]
	--> rotateRight : List a -> List a
	rotateRight = l -> splitAt (pred (length l)) l
		> ([front, back] -> prepend back front),       -- [a; b; c] -> [c; a; b]

	--> sum3 : Num -> Num -> Num -> Num
	sum3 = a -> b -> c -> add a (add b c),

	-- Sum of each cell and its left/right neighbours, then of each row and the
	-- rows above and below: the full 3x3 sum, including the cell itself.
	--> horizontal : List Num -> List Num
	horizontal    = row  -> zipWith3 sum3 (rotateLeft row) row (rotateRight row),
	--> neighbourhood : List (List Num) -> List (List Num)
	neighbourhood = rows -> let sums = map horizontal rows in
		zipWith3 (zipWith3 sum3) (rotateLeft sums) sums (rotateRight sums),

	--> rule : Num -> Num -> Num
	rule = alive -> total ->
		when       (eq total 3)             1  -- three neighbours: birth or survival
		> elseWhen (and (eq total 4) alive) 1  -- two neighbours and already alive
		> default                           0,

	--> step : List (List Num) -> List (List Num)
	step = rows -> zipWith (zipWith rule) rows (neighbourhood rows),

	-- Rendering -------------------------------------------------------------
	--
	-- A cell is coloured by comparing the frame with the one before it, which is
	-- possible only because the previous generation is still an ordinary value.

	--> cell : Num -> Num -> List Num
	cell = previous -> current ->
		when       (and current (not previous)) (prepend born     "██")
		> elseWhen (and current previous)       (prepend survivor "██")
		> default                               "  ",

	--> rowText : List Num -> List Num -> List Num
	rowText = previousRow -> currentRow -> zipWith cell previousRow currentRow > flatten,

	--> header : Num -> List (List Num) -> List Num
	header = generation -> grid -> flatten [
		plain; "Life  ";
		string width; "x"; string height; " torus  ";
		"generation "; padLeft 4 space (string generation); "/"; string frames;
		"  "; padLeft 4 space (string (grid > map sum > sum)); " alive"
	],

	-- `home` puts the cursor back at the top left instead of clearing, so the
	-- new frame overwrites the old one in place and the screen does not flash.
	--> draw : Num -> List (List Num) -> List (List Num) -> List (List Num)
	draw = generation -> previous -> current ->
		seq (bwrite home)
			(prepend [header generation current;] (zipWith rowText previous current)
				> writeList),

	-- The frame delay: a loop that computes nothing, forced by `seq`.
	--> spin : Num -> Num
	spin = { 0 -> 0, n -> spin (sub 1 n) },

	--> play : Num -> List (List Num) -> Stream (List (List Num)) -> List Num
	play = remaining -> previous -> { [current, rest] ->
		if (eq remaining 0)
			(seq (bwrite plain) (write "done"))
			(seq (draw (sub remaining frames) previous current)
				(seq (spin frameDelay)
					(play (pred remaining) current rest))) }

in
	-- `iterate step soup` is passed straight into the loop rather than bound to
	-- a name. A name would be a root the whole run: every generation ever
	-- computed would stay reachable and memoized, and the animation would slow
	-- down as it went (it does — try it). Unnamed, each cell is consumed once
	-- and collected, and the run holds two boards at a time.
	seq (bwrite clear) (play frames soup (iterate step soup))
